{%- comment -%}
  Linien-Icons für die Nutzen-Sektionen (Wirkung, Für wen).
  Gleicher Strich wie snippets/icon.liquid, aber größer (28px) für Karten.
  Aufruf: {% render 'benefit-icon', icon: 'feather' %}
{%- endcomment -%}
{%- case icon -%}
{%- when 'feather' -%}<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.2 3.8a6 6 0 0 0-8.5 0L5 10.5V19h8.5l6.7-6.7a6 6 0 0 0 0-8.5z"/><path d="M16 8L2 22"/><path d="M17.5 15H9"/></svg>
{%- when 'muscle' -%}<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 18c2-1 3.5-3 4-6l1-4c.4-1.6 2-2.6 3.6-2.2l.9.2-1 3 2.5.5"/><path d="M8 12c2.5-1.5 6-1.6 8.5 0 2.4 1.5 3.5 4 3.5 6.5H4"/></svg>
{%- when 'bolt' -%}<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/></svg>
{%- when 'moon' -%}<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z"/><path d="M16 3v3M14.5 4.5h3"/></svg>
