{%- when 'plane' -%}<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.5 13.5L3 11l1.5-1.5 8 .5 4-4c1-1 2.5-1.5 3.5-.5s.5 2.5-.5 3.5l-4 4 .5 8L14.5 22 12 14.5"/><path d="M6 16l-3 1 4 4 1-3"/></svg>
