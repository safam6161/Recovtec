{%- comment -%}
  JSON-LD BreadcrumbList-Schema (schema.org).
  Aktuell für die Produktseite: Startseite [> Kategorie] > Produkt.
  Eingebunden über sections/main-product.liquid.
{%- endcomment -%}
{%- if product != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Startseite",
      "item": {{ shop.url | json }}
    },
    {%- if product.collections.size > 0 -%}
    {%- assign bc_collection = product.collections.first -%}
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ bc_collection.title | json }},
      "item": "{{ shop.url }}{{ bc_collection.url }}"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ product.title | json }},
      "item": {{ canonical_url | json }}
    }
    {%- else -%}
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ product.title | json }},
      "item": {{ canonical_url | json }}
    }
    {%- endif -%}
  ]
}
</script>
{%- endif -%}
