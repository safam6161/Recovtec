<div class="drawer-overlay"></div>
<aside class="drawer" aria-label="{{ settings.cart_title | default: 'Warenkorb' }}">
  <header class="drawer-head">
    <div class="title">{{ settings.cart_title | default: 'Warenkorb' }} · <span class="cart-count-drawer">0</span></div>
    <button class="drawer-close" aria-label="{{ settings.cart_close | default: 'Schließen' }}">{% render 'icon', icon: 'close' %}</button>
  </header>
  <div class="drawer-body">
    <div class="cart-empty">
      {% render 'icon', icon: 'cart' %}
      <div>
        <div class="h-4" style="margin-bottom:4px">{{ settings.cart_empty_title | default: 'Noch leer' }}</div>
        <div style="font-size:13px">{{ settings.cart_empty_text | default: 'Füge die Recovery Boots hinzu — und du bist startklar.' }}</div>
      </div>
    </div>
  </div>
  <div class="drawer-foot" style="display:none">
    <div class="sub">
      <span class="lbl">{{ settings.cart_subtotal | default: 'Zwischensumme' }}</span>
      <span class="val">0 €</span>
    </div>
    <a href="/checkout" class="btn btn-primary btn-lg" style="width:100%;justify-content:center">
      {{ settings.cart_checkout | default: 'Zur Kasse' }} {% render 'icon', icon: 'arrow' %}
    </a>
    <div class="note">{{ settings.cart_note | default: 'Versand 1–3 Werktage · 30 Tage Geld zurück' }}</div>
  </div>
</aside>
