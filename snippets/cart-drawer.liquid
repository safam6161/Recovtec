<div class="drawer-overlay"></div>
<aside class="drawer" aria-label="Warenkorb">
  <header class="drawer-head">
    <div class="title">Warenkorb · 0</div>
    <button class="drawer-close" aria-label="Schließen">{% render 'icon', icon: 'close' %}</button>
  </header>
  <div class="drawer-body">
    <div class="cart-empty">
      {% render 'icon', icon: 'cart' %}
      <div>
        <div class="h-4" style="margin-bottom:4px">Noch leer</div>
        <div style="font-size:13px">Füge die Recovery Boots hinzu — und du bist startklar.</div>
      </div>
    </div>
  </div>
  <div class="drawer-foot" style="display:none">
    <div class="sub">
      <span class="lbl">Zwischensumme</span>
      <span class="val">0 €</span>
    </div>
    <a href="/checkout" class="btn btn-primary btn-lg" style="width:100%;justify-content:center">
      Zur Kasse {% render 'icon', icon: 'arrow' %}
    </a>
    <div class="note">Versand 1–3 Werktage · 30 Tage Geld zurück</div>
  </div>
</aside>
