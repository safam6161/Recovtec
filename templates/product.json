        "faq3": {
          "type": "item",
          "settings": {
            "question": "Welche Größe passt mir?",
            "answer": "Größe M passt bis 1,80 m Körpergröße, Größe L ab 1,80 m. Die Erweiterungslaschen sind dabei und bieten +10 cm Spielraum am ganzen Bein — bei Zweifeln nimm die größere Variante."
          }
        },
        "faq4": {
          "type": "item",
          "settings": {
            "question": "Brauche ich eine App oder WLAN?",
            "answer": "Nein. Anschalten, Modus und Druckstufe direkt am LED-Controller wählen, fertig. Keine App, kein Bluetooth, kein Konto."
          }
        },
        "faq5": {
          "type": "item",
          "settings": {
            "question": "Wie oft sollte ich sie nutzen?",
            "answer": "Eine Session dauert 15–45 Minuten. Du kannst sie täglich nutzen — typisch nach dem Training oder an Ruhetagen. Es gibt kein Zuviel."
          }
        },
        "faq6": {
          "type": "item",
          "settings": {
            "question": "Welche Druckstufe als Anfänger?",
            "answer": "Starte mit Stufe 2. Angenehm und effektiv. Steigere dich nach Bedarf — höhere Stufen für tiefere Regeneration. Maximum ist Stufe 7 (240 mmHg)."
          }
        },
        "faq7": {
          "type": "item",
          "settings": {
            "question": "Wie lange hält der Akku?",
            "answer": "Bis zu 3 Stunden im Betrieb. Reicht für mehrere Sessions ohne Aufladen — auch unterwegs oder im Trainingslager."
          }
        },
