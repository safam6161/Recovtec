<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} — Demnächst</title>
  {{ content_for_header }}
  <style>
    body { margin: 0; font-family: "Inter Tight", sans-serif; background: #0a0a0a; color: #fafafa; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
    .pw-wrap { text-align: center; padding: 40px; }
    .pw-wrap h1 { font-size: clamp(32px, 5vw, 64px); font-weight: 700; letter-spacing: -0.03em; margin: 0 0 16px; }
    .pw-wrap p { font-size: 16px; color: #8a8a8a; margin: 0 0 32px; }
    .pw-form { display: flex; gap: 8px; justify-content: center; }
    .pw-form input { padding: 14px 16px; background: #1a1a1a; border: 1px solid #2a2a2a; color: #fafafa; font-size: 15px; width: 240px; }
    .pw-form button { padding: 14px 24px; background: #fafafa; color: #0a0a0a; font-weight: 600; font-size: 15px; border: none; cursor: pointer; }
  </style>
</head>
<body>
  <div class="pw-wrap">
    <h1>{{ shop.name }}</h1>
    <p>Wir bauen gerade auf. Komm bald zurück.</p>
    {% form 'storefront_password' %}
      <div class="pw-form">
        <input type="password" name="password" placeholder="Passwort eingeben">
        <button type="submit">Eintreten</button>
      </div>
      {{ form.errors | default_errors }}
    {% endform %}
  </div>
  {{ content_for_layout }}
</body>
</html>
