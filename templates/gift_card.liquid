{% layout 'gift_card' %}
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ 'gift_cards.issued.title' | t }}</title>
  {{ content_for_header }}
</head>
<body>
  <div style="max-width:600px;margin:80px auto;text-align:center;font-family:sans-serif">
    <h1>Geschenkkarte</h1>
    <p>Betrag: {{ gift_card.initial_value | money }}</p>
    <p>Code: <strong>{{ gift_card.code | format_code }}</strong></p>
    {% if gift_card.expired %}
      <p>Diese Geschenkkarte ist abgelaufen.</p>
    {% endif %}
  </div>
</body>
</html>
