{% layout 'gift_card' %}
<div style="max-width:560px;margin:80px auto;padding:0 24px;text-align:center">
  <h1 style="font-size:24px;font-weight:700;margin-bottom:24px">Geschenkkarte</h1>
  <p>Betrag: <strong>{{ gift_card.initial_value | money }}</strong></p>
  <p style="margin-top:16px;font-size:20px;letter-spacing:0.1em;background:#f2f2f2;padding:16px">{{ gift_card.code | format_code }}</p>
  {%- if gift_card.expired -%}
    <p style="color:#dc2626;margin-top:16px">Diese Geschenkkarte ist abgelaufen.</p>
  {%- endif -%}
</div>
