<section class="final-cta">
  <div class="final-bg"></div>
  <div class="container">
    <div class="final-cta-inner">
      <h2>
        {%- assign lines = section.settings.headline | newline_to_br | split: '<br />' -%}
        {%- for line in lines -%}
          <span style="display:block">{% if forloop.last %}<em>{{ line }}</em>{% else %}{{ line }}{% endif %}</span>
        {%- endfor -%}
      </h2>
      <div class="side">
        <p>{{ section.settings.subtext }}</p>
        <a href="{{ section.settings.cta_url | default: routes.collections_url }}" class="btn btn-primary btn-lg" style="align-self:flex-start">
          {{ section.settings.cta_label }}
          <span class="btn-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 9h14M11 4l5 5-5 5"/></svg></span>
        </a>
        <div class="final-cta-guarantees">
          <div><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 7h11v9H2zM13 10h5l3 3v3h-8z"/><circle cx="6" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg> {{ section.settings.trust_1 }}</div>
          <div><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 12a8 8 0 0 1 14-5l2-2v6h-6l2.5-2.5"/><path d="M20 12a8 8 0 0 1-14 5l-2 2v-6h6l-2.5 2.5"/></svg> {{ section.settings.trust_2 }}</div>
          <div><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 3l8 3v6c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V6l8-3z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg> {{ section.settings.trust_3 }}</div>
          <div><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg> {{ section.settings.trust_4 }}</div>
        </div>
        {%- if section.settings.show_newsletter -%}
        <div class="final-cta-nl" data-newsletter>
          <div class="nl-lbl">{{ section.settings.nl_label }}</div>
          <form class="final-nl-form" action="/contact#newsletter-form" method="post" accept-charset="UTF-8">
            <input type="hidden" name="form_type" value="customer">
            <input type="hidden" name="utf8" value="✓">
            <input type="email" name="contact[email]" required autocomplete="email" placeholder="{{ section.settings.nl_placeholder }}">
            <button type="submit" aria-label="Abonnieren">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 9h14M11 4l5 5-5 5"/></svg>
            </button>
          </form>
          <div class="nl-fine">{{ section.settings.nl_fine }}</div>
          <div class="final-nl-msg" role="status" aria-live="polite" hidden
               data-success="{{ section.settings.nl_success | escape }}"
               data-error="{{ section.settings.nl_error | escape }}"></div>
        </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    { "type": "textarea", "id": "headline", "label": "Headline (letzte Zeile wird kursiv)", "default": "Bereit für die\nbessere Recovery?" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Ein Produkt. Alles dabei. Direkt vom Hersteller verschickt. Wenn's nicht passt, schickst du es zurück — kostenlos, ohne Diskussion." },
    { "type": "text", "id": "cta_label", "label": "Button Text", "default": "Jetzt bestellen" },
    { "type": "url", "id": "cta_url", "label": "Button Link" },
    { "type": "header", "content": "Vertrauens-Icons" },
    { "type": "text", "id": "trust_1", "label": "Icon 1 Text", "default": "Kostenloser Versand" },
    { "type": "text", "id": "trust_2", "label": "Icon 2 Text", "default": "30 Tage Geld-zurück-Garantie" },
    { "type": "text", "id": "trust_3", "label": "Icon 3 Text", "default": "1–3 Tage Lieferung" },
    { "type": "text", "id": "trust_4", "label": "Icon 4 Text", "default": "1 Jahr Garantie" },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Newsletter anzeigen", "default": true },
    { "type": "text", "id": "nl_label", "label": "Newsletter Label", "default": "Newsletter — Updates & frühe Drops" },
    { "type": "text", "id": "nl_placeholder", "label": "E-Mail Placeholder", "default": "deine@email.de" },
    { "type": "text", "id": "nl_fine", "label": "Newsletter Hinweis", "default": "Kein Spam. Jederzeit abbestellbar." },
    { "type": "textarea", "id": "nl_success", "label": "Erfolgsmeldung (nach Eintragung)", "default": "Fast geschafft! Wir haben dir eine Bestätigungs-E-Mail geschickt. Bitte bestätige deine Anmeldung über den Link in der E-Mail." },
    { "type": "textarea", "id": "nl_error", "label": "Fehlermeldung", "default": "Hoppla, das hat nicht geklappt. Bitte versuche es gleich noch einmal." }
  ],
  "presets": [{ "name": "Final CTA" }]
}
{% endschema %}
