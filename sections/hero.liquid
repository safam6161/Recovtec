<section class="hero">
  <div class="hero-media">
    {%- assign hero_has_desktop = false -%}
    {%- if section.settings.hero_image != blank or section.settings.hero_image_url != blank -%}{%- assign hero_has_desktop = true -%}{%- endif -%}
    {%- assign hero_has_mobile = false -%}
    {%- if section.settings.hero_image_mobile != blank -%}{%- assign hero_has_mobile = true -%}{%- endif -%}

    {%- if hero_has_desktop or hero_has_mobile -%}
      <picture>
        {%- if hero_has_mobile and hero_has_desktop -%}
          <source media="(max-width: 1024px)" srcset="{{ section.settings.hero_image_mobile | image_url: width: 1200 }}">
        {%- endif -%}
        {%- if section.settings.hero_image != blank -%}
          <img src="{{ section.settings.hero_image | image_url: width: 2000 }}" alt="{{ section.settings.hero_image.alt | default: 'Recovtec Recovery Boots' }}" loading="eager" fetchpriority="high">
        {%- elsif section.settings.hero_image_url != blank -%}
          <img src="{{ section.settings.hero_image_url }}" alt="Recovtec Recovery Boots" loading="eager" fetchpriority="high">
        {%- else -%}
          <img src="{{ section.settings.hero_image_mobile | image_url: width: 2000 }}" alt="{{ section.settings.hero_image_mobile.alt | default: 'Recovtec Recovery Boots' }}" loading="eager" fetchpriority="high">
        {%- endif -%}
      </picture>
    {%- else -%}
      <div class="hero-placeholder">
        <div class="placeholder-label" style="background:rgba(0,0,0,0.55);color:rgba(255,255,255,0.7)">HERO · Sportler nach hartem Training mit Recovery Boots · Bild oder Video, full-bleed</div>
      </div>
    {%- endif -%}
  </div>
  <div class="hero-overlay"></div>
  <div class="container hero-content">
    <h1 class="hero-headline">
      {%- assign lines = section.settings.headline | newline_to_br | split: '<br />' -%}
      {%- for line in lines -%}<span style="display:block">{{ line }}</span>{%- endfor -%}
    </h1>
    {%- if section.settings.subhead != blank -%}
      <p class="hero-subhead">{{ section.settings.subhead }}</p>
    {%- endif -%}
    <div class="hero-cta-row">
      <a href="{{ section.settings.cta_url | default: '#solution' }}" class="btn btn-primary btn-lg">
        {{ section.settings.cta_label }}
        <span class="btn-icon"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 7h10M8 3l4 4-4 4"/></svg></span>
      </a>
      {%- if section.settings.price_label != blank -%}
        <span class="hero-price">{{ section.settings.price_label }}</span>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero Bild" },
    { "type": "text", "id": "hero_image_url", "label": "Hero Bild URL (Fallback)", "info": "Wird genutzt wenn kein Hero-Bild ausgewählt ist." },
    { "type": "image_picker", "id": "hero_image_mobile", "label": "Hero Bild (Mobil)", "info": "Optional. Eigenes hohes/quadratisches Bild fürs Handy. Wenn leer, wird das Desktop-Bild verwendet." },
    { "type": "textarea", "id": "headline", "label": "Headline", "default": "HART TRAINIERT.\nSCHNELL ERHOLT.\nRECOVTEC." },
    { "type": "textarea", "id": "subhead", "label": "Sub-Headline", "default": "Pneumatische Recovery Boots — kabellos, leise, 5 Modi, 7 Druckstufen bis 240 mmHg. 30 Tage testen." },
    { "type": "text", "id": "cta_label", "label": "Button Text", "default": "Produkt ansehen" },
    { "type": "url", "id": "cta_url", "label": "Button Link" },
    { "type": "text", "id": "price_label", "label": "Preis-Hinweis", "default": "Ab 499 € · inkl. MwSt. · kostenloser Versand" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
