<section class="hero">
  <div class="hero-media">
    {%- if section.settings.hero_image != blank -%}
      {{ section.settings.hero_image | image_url: width: 1800 | image_tag: alt: section.settings.hero_image.alt, loading: 'eager', fetchpriority: 'high' }}
    {%- else -%}
      <div class="placeholder dark" style="height:100%;position:absolute;inset:0">
        <div class="placeholder-label">HERO · Sportler nach hartem Training mit Recovery Boots · Bild oder Video, full-bleed</div>
      </div>
    {%- endif -%}
  </div>
  <div class="hero-overlay"></div>
  <div class="container hero-content">
    <h1 class="hero-headline">
      {%- assign lines = section.settings.headline | newline_to_br | split: '<br />' -%}
      {%- for line in lines -%}
        <span style="display:block">{{ line }}</span>
      {%- endfor -%}
    </h1>
    <div class="hero-cta-row">
      <a href="{{ section.settings.cta_url | default: routes.collections_url }}" class="btn btn-primary btn-lg">
        {{ section.settings.cta_label }}
        <span class="btn-icon">{% render 'icon', icon: 'arrow' %}</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero Bild" },
    { "type": "textarea", "id": "headline", "label": "Headline (Zeilenumbruch mit Enter)", "default": "HART TRAINIERT.\nSCHNELL ERHOLT.\nRECOVTEC." },
    { "type": "text", "id": "cta_label", "label": "Button Text", "default": "Jetzt kaufen" },
    { "type": "url", "id": "cta_url", "label": "Button Link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
