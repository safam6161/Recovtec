{% comment %}
  Guarantee banner is embedded in product-story.liquid as a block type "guarantee".
  This section exists for standalone use if needed.
{% endcomment %}
<section class="guarantee-banner">
  <div class="container guarantee-content">
    <div class="guarantee-num">{{ section.settings.days }}</div>
    <div class="guarantee-text">
      <span class="guarantee-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.headline }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guarantee Banner",
  "settings": [
    { "type": "text", "id": "days", "label": "Tage", "default": "30" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Risikofrei testen" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Tage Geld zurück." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Probier die Boots in Ruhe zuhause. Wenn sie dich nicht überzeugen, schickst du sie kostenfrei zurück — ohne Diskussion, ohne Begründung." }
  ],
  "presets": [{ "name": "Guarantee Banner" }]
}
{% endschema %}
