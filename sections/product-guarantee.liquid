<section class="guarantee dark">
  <div class="container guarantee-inner">
    <div class="guarantee-badge">
      {% render 'icon', icon: 'shield' %}
      <span class="guarantee-days">{{ section.settings.days }}</span>
    </div>
    <div class="guarantee-body">
      <h2>{{ section.settings.headline }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guarantee Banner",
  "settings": [
    { "type": "text", "id": "days", "label": "Tage", "default": "30" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Tage Geld-zurück-Garantie" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Wir sind überzeugt von unserem Produkt. Wenn du nicht 100 % zufrieden bist, erstatten wir dir den vollen Kaufpreis – kein Kleingedrucktes, keine Fragen." }
  ],
  "presets": [{ "name": "Guarantee Banner" }]
}
{% endschema %}
