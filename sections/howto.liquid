<section class="howto" id="howto">
  <div class="container">
    <div class="section-head">
      <div class="left">
        <span class="eyebrow" style="display:block;margin-bottom:16px">{{ section.settings.eyebrow }}</span>
        <h2 class="h-2">{{ section.settings.headline }}</h2>
      </div>
      <p style="max-width:36ch;color:var(--mute)">{{ section.settings.subtext }}</p>
    </div>

    <div class="howto-steps">
      {%- for block in section.blocks -%}
        {%- if block.type == 'step' -%}
          <div class="howto-step" {{ block.shopify_attributes }}>
            <div class="step-big">{{ forloop.index | prepend: '0' }}</div>
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'foot' -%}
        <div class="howto-foot" {{ block.shopify_attributes }}>
          <div class="ico">{% render 'icon', icon: block.settings.icon | default: 'bolt' %}</div>
          <div class="txt">
            <h5>{{ block.settings.title }}</h5>
            <p>{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "How To",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "03 — Anwendung" },
    { "type": "textarea", "id": "headline", "label": "Headline", "default": "In 4 Schritten zur\nbesseren Recovery." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Keine App, kein Pairing, keine Anleitung mit 30 Seiten. Anziehen, einschalten, fertig." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Schritt",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Anziehen" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Beine in die Boots, Reißverschluss zu." }
      ]
    },
    {
      "type": "foot",
      "name": "Fußzeile",
      "limit": 1,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "bolt", "options": [
          { "value": "bolt", "label": "Blitz" },
          { "value": "check", "label": "Haken" },
          { "value": "shield", "label": "Schild" },
          { "value": "truck", "label": "LKW" },
          { "value": "warranty", "label": "Garantie" }
        ]},
        { "type": "text", "id": "title", "label": "Titel", "default": "Direkt einsatzbereit aus der Box" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Akku vorgeladen. Keine Software, kein Pairing, kein Konto. In unter 60 Sekunden startklar." }
      ]
    }
  ],
  "presets": [{
    "name": "How To",
    "blocks": [
      { "type": "step", "settings": { "title": "Anziehen", "text": "Beine in die Boots, Reißverschluss zu." } },
      { "type": "step", "settings": { "title": "Modus wählen", "text": "Einer der 5 Modi am LED-Controller wählen." } },
      { "type": "step", "settings": { "title": "Druck einstellen", "text": "Start mit Stufe 80 mmHg. Steigere dich nach Bedarf — bis 240 mmHg möglich." } },
      { "type": "step", "settings": { "title": "15–45 Minuten erholen", "text": "Hinlegen, Augen zu, Serie schauen. Nach der Session fühlst du den Unterschied." } },
      { "type": "foot", "settings": { "title": "Direkt einsatzbereit aus der Box", "text": "Akku vorgeladen. Keine Software, kein Pairing, kein Konto. In unter 60 Sekunden startklar." } }
    ]
  }]
}
{% endschema %}
