<section class="compare">
  <div class="container">
    <div class="section-head">
      <div class="left">
        <span class="eyebrow" style="color:rgba(250,250,250,0.55);display:block;margin-bottom:16px">{{ section.settings.eyebrow }}</span>
        <h2 class="h-2">{{ section.settings.headline }}</h2>
      </div>
    </div>

    <div class="compare-table two-col">
      <div class="compare-cell head feat-name" style="background:rgba(255,255,255,0.04)">Merkmal</div>
      {%- for block in section.blocks -%}
        <div class="compare-cell head {% if block.settings.highlight %}us{% endif %}" {{ block.shopify_attributes }}>
          {{ block.settings.col_label }}
          {%- if block.settings.badge != blank -%}<span class="compare-tag">{{ block.settings.badge }}</span>{%- endif -%}
        </div>
      {%- endfor -%}

      {%- assign rows = section.settings.rows | split: '|' -%}
      {%- for row in rows -%}
        {%- assign cells = row | split: ',' -%}
        <div class="compare-cell feat-name">{{ cells[0] | strip }}</div>
        {%- for block in section.blocks -%}
          {%- assign val = cells[forloop.index] | strip -%}
          <div class="compare-cell {% if block.settings.highlight %}us{% endif %}">
            {%- if val == 'check' -%}<span class="check">✓ Inklusive</span>
            {%- elsif val == 'x' -%}<span class="x">— Nicht enthalten</span>
            {%- else -%}{{ val }}{%- endif -%}
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Compare",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "04 — Vergleich" },
    { "type": "textarea", "id": "headline", "label": "Headline", "default": "Recovtec Pro vs. der Rest.\nVolle Ausstattung, kein Hokuspokus." },
    {
      "type": "textarea",
      "id": "rows",
      "label": "Zeilen (Merkmal, Wert1, Wert2 — mit | getrennt; check / x für Icons)",
      "default": "Druckstufen,bis 240 mmHg,bis 180 mmHg|Massage-Modi,5,3|Akkubetrieb,Ja · 3 Std,Teils|Lautstärke,< 45 dB,> 60 dB|App / Pairing nötig,Nein,Oft ja|Rucksack inklusive,check,x|Erweiterungslaschen,check,x"
    }
  ],
  "blocks": [
    {
      "type": "col",
      "name": "Spalte",
      "settings": [
        { "type": "text", "id": "col_label", "label": "Spalten-Label", "default": "Recovtec Pro" },
        { "type": "text", "id": "badge", "label": "Badge (optional)", "default": "DAS PAKET" },
        { "type": "checkbox", "id": "highlight", "label": "Hervorheben", "default": true }
      ]
    }
  ],
  "presets": [{
    "name": "Compare",
    "blocks": [
      { "type": "col", "settings": { "col_label": "Recovtec Pro", "badge": "DAS PAKET", "highlight": true } },
      { "type": "col", "settings": { "col_label": "Andere Brands", "badge": "", "highlight": false } }
    ]
  }]
}
{% endschema %}
