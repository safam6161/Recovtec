<section class="compare" id="compare">
  <div class="container">
    <div class="section-head">
      <div class="left">
        <span class="eyebrow" style="color:rgba(250,250,250,0.55);display:block;margin-bottom:16px">{{ section.settings.eyebrow }}</span>
        <h2 class="h-2">{{ section.settings.headline }}</h2>
      </div>
    </div>

    <div class="compare-table two-col">
      <div class="compare-cell head feat-name" style="background:rgba(255,255,255,0.04)">Merkmal</div>
      <div class="compare-cell head us">{{ section.settings.col1_label }}</div>
      <div class="compare-cell head">{{ section.settings.col2_label }}</div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'row' -%}
          <div class="compare-cell feat-name" {{ block.shopify_attributes }}>{{ block.settings.feature }}</div>
          {%- assign our_val = block.settings.our_value | strip -%}
          {%- assign their_val = block.settings.competitor_value | strip -%}
          <div class="compare-cell us">
            {%- if our_val == 'check' -%}<span class="check">✓ Inklusive</span>
            {%- elsif our_val == 'x' -%}<span class="x">— Nicht enthalten</span>
            {%- else -%}{{ our_val }}{%- endif -%}
          </div>
          <div class="compare-cell">
            {%- if their_val == 'check' -%}<span class="check">✓ Inklusive</span>
            {%- elsif their_val == 'x' -%}<span class="x">— Nicht enthalten</span>
            {%- else -%}{{ their_val }}{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vergleich",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Vergleich" },
    { "type": "textarea", "id": "headline", "label": "Headline", "default": "Recovtec Pro vs. der Rest.\nVolle Ausstattung, kein Hokuspokus." },
    { "type": "text", "id": "col1_label", "label": "Spalte 1 — Name (Recovtec)", "default": "Recovtec Pro" },
    { "type": "text", "id": "col2_label", "label": "Spalte 2 — Name (Konkurrenz)", "default": "Andere Brands" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Vergleichs-Zeile",
      "settings": [
        { "type": "text", "id": "feature", "label": "Merkmal", "default": "Druckstufen" },
        { "type": "text", "id": "our_value", "label": "Recovtec Wert (check / x / Text)", "default": "bis 240 mmHg" },
        { "type": "text", "id": "competitor_value", "label": "Konkurrenz Wert (check / x / Text)", "default": "bis 180 mmHg" }
      ]
    }
  ],
  "presets": [{
    "name": "Vergleich",
    "blocks": [
      { "type": "row", "settings": { "feature": "Druckstufen", "our_value": "bis 240 mmHg", "competitor_value": "bis 180 mmHg" } },
      { "type": "row", "settings": { "feature": "Massage-Modi", "our_value": "5", "competitor_value": "3" } },
      { "type": "row", "settings": { "feature": "Akkubetrieb", "our_value": "Ja · 3 Std", "competitor_value": "Teils" } },
      { "type": "row", "settings": { "feature": "Lautstärke", "our_value": "< 45 dB", "competitor_value": "> 60 dB" } },
      { "type": "row", "settings": { "feature": "App / Pairing nötig", "our_value": "Nein", "competitor_value": "Oft ja" } },
      { "type": "row", "settings": { "feature": "Rucksack inklusive", "our_value": "check", "competitor_value": "x" } },
      { "type": "row", "settings": { "feature": "Erweiterungslaschen", "our_value": "check", "competitor_value": "x" } }
    ]
  }]
}
{% endschema %}
