<section class="faq section-pad" id="faq">
  <div class="container">

    <div class="faq-head">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.headline }}</h2>
    </div>

    <div class="faq-list">
      {%- for block in section.blocks -%}
        <details class="faq-item" {{ block.shopify_attributes }}>
          <summary class="faq-q">
            <span>{{ block.settings.question }}</span>
            <span class="faq-icon">{% render 'icon', icon: 'arrow' %}</span>
          </summary>
          <div class="faq-a">
            <p>{{ block.settings.answer }}</p>
          </div>
        </details>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "06 — FAQ" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Häufige Fragen." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Frage",
      "settings": [
        { "type": "text", "id": "question", "label": "Frage", "default": "Für wen sind die Recovery Boots geeignet?" },
        { "type": "textarea", "id": "answer", "label": "Antwort", "default": "Für alle, die regelmäßig Sport treiben – egal ob Läufer, Radfahrer, Kraftsportler oder Teamsportler." }
      ]
    }
  ],
  "presets": [{
    "name": "FAQ",
    "blocks": [
      { "type": "item", "settings": { "question": "Für wen sind die Recovery Boots geeignet?", "answer": "Für alle, die regelmäßig Sport treiben – egal ob Läufer, Radfahrer, Kraftsportler oder Teamsportler. Auch bei berufsbedingtem langen Stehen oder Sitzen sind die Boots eine hervorragende Entlastung." } },
      { "type": "item", "settings": { "question": "Wie oft und wie lange sollte ich die Boots nutzen?", "answer": "20–30 Minuten nach dem Training reichen für eine optimale Wirkung. Du kannst sie täglich nutzen – viele Athleten schwören auf die abendliche Routine direkt nach dem Sport oder vor dem Schlafen." } },
      { "type": "item", "settings": { "question": "Gibt es eine Größe, die für alle passt?", "answer": "Ja, die RECOVTEC Boots sind in zwei Größen erhältlich: S/M (Schuhgröße 36–42) und L/XL (Schuhgröße 42–48). Das Bein-Design passt für nahezu alle Beinlängen." } },
      { "type": "item", "settings": { "question": "Wie lange dauert die Lieferung?", "answer": "Wir liefern innerhalb von 1–3 Werktagen innerhalb Deutschlands, Österreichs und der Schweiz. Der Versand ist ab einem Bestellwert von 50 € kostenlos." } },
      { "type": "item", "settings": { "question": "Gilt die 30-Tage-Geld-zurück-Garantie?", "answer": "Absolut. Wenn du nicht 100 % zufrieden bist, schickst du die Boots einfach zurück und wir erstatten den vollen Kaufpreis – ohne Wenn und Aber." } }
    ]
  }]
}
{% endschema %}
