<section class="faq" id="faq">
  <div class="container">
    <div class="faq-grid">
      <div class="faq-side">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="h-2">{{ section.settings.headline }}</h2>
        <p>{{ section.settings.subtext }}</p>
        <div class="contact-card">
          <span class="label">Direkter Kontakt</span>
          <div class="h-4">{{ section.settings.email }}</div>
          <a href="mailto:{{ section.settings.email }}">Nachricht schreiben →</a>
        </div>
      </div>
      <div>
        <div class="acc">
          {%- for block in section.blocks -%}
            <div class="acc-item" {{ block.shopify_attributes }}>
              <button class="acc-trigger">
                {{ block.settings.question }}
                <span class="plus">+</span>
              </button>
              <div class="acc-body">
                <div>
                  <div class="acc-body-inner">{{ block.settings.answer }}</div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "05 — FAQ" },
    { "type": "textarea", "id": "headline", "label": "Headline", "default": "Häufige Fragen.\nKlare Antworten." },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Du hast eine andere Frage? Schreib uns direkt — meistens antworten wir innerhalb eines Werktages." },
    { "type": "text", "id": "email", "label": "E-Mail", "default": "support@recovtec.de" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Frage",
      "settings": [
        { "type": "text", "id": "question", "label": "Frage", "default": "Für wen sind die Recovery Boots gedacht?" },
        { "type": "textarea", "id": "answer", "label": "Antwort", "default": "Für alle, die ihre Beine regelmäßig belasten — Läufer, Kraftsportler, Mannschaftssportler, CrossFit-Athleten, Triathleten." }
      ]
    }
  ],
  "presets": [{
    "name": "FAQ",
    "blocks": [
      { "type": "item", "settings": { "question": "Für wen sind die Recovery Boots gedacht?", "answer": "Für alle, die ihre Beine regelmäßig belasten — Läufer, Kraftsportler, Mannschaftssportler, CrossFit-Athleten, Triathleten. Aber auch für lange Bürotage und schwere Beine nach einem stressigen Tag." } },
      { "type": "item", "settings": { "question": "Wie oft und wie lange soll ich sie nutzen?", "answer": "Eine Session dauert 20–30 Minuten. Du kannst sie täglich nutzen — typisch nach dem Training oder an Ruhetagen. Es gibt kein Zuviel, solange du dich wohl fühlst." } },
      { "type": "item", "settings": { "question": "Welche Druckstufe sollte ich am Anfang wählen?", "answer": "Starte mit Stufe 80 mmHg. Das ist angenehm und effektiv. Steigere dich nach Bedarf — höhere Stufen für tiefere Regeneration, niedrigere für sanftes Cool-Down." } },
      { "type": "item", "settings": { "question": "Brauche ich eine App oder WLAN?", "answer": "Nein. Anschalten, Modus und Druckstufe am LED-Controller wählen, fertig. Keine App, kein Bluetooth, kein Konto. Bewusst so designt." } },
      { "type": "item", "settings": { "question": "Welche Größe passt mir?", "answer": "Größe M passt bis 1,80 m Körpergröße, Größe L ab 1,80 m. Die mitgelieferten Erweiterungslaschen geben dir zusätzlichen Spielraum von +10 cm." } },
      { "type": "item", "settings": { "question": "Was, wenn sie mir nicht gefallen?", "answer": "30 Tage Geld-zurück-Garantie. Du testest sie zuhause — gefallen sie dir nicht, schickst du sie kostenfrei zurück und bekommst dein Geld zurück. Ohne Diskussion." } }
    ]
  }]
}
{% endschema %}
