<section style="padding:80px 24px;max-width:760px;margin:0 auto">
  <p style="color:var(--mute);font-size:13px;margin-bottom:16px">{{ article.published_at | date: '%d.%m.%Y' }}</p>
  <h1 style="font-size:clamp(24px,3vw,36px);font-weight:700;margin-bottom:32px">{{ article.title }}</h1>
  {%- if article.image -%}
    <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt }}" style="width:100%;aspect-ratio:16/9;object-fit:cover;margin-bottom:40px">
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
  <a href="{{ blog.url }}" style="display:inline-flex;align-items:center;gap:8px;margin-top:48px;color:var(--mute);text-decoration:none;font-size:14px">
    ← Zurück zum Blog
  </a>
</section>

{% schema %}
{ "name": "Artikel" }
{% endschema %}
