<section class="social-proof section-pad" id="reviews">
  <div class="container">

    <div class="sp-head">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.headline }}</h2>
      <div class="sp-aggregate">
        <div class="star-row">
          {%- for i in (1..5) -%}{% render 'icon', icon: 'star' %}{%- endfor -%}
        </div>
        <span class="sp-score">{{ section.settings.rating }}</span>
        <span class="sp-count">{{ section.settings.review_count }}</span>
      </div>
    </div>

    <div class="review-grid">
      {%- for block in section.blocks -%}
        <div class="review-card" {{ block.shopify_attributes }}>
          <div class="review-stars">
            {%- for i in (1..5) -%}{% render 'icon', icon: 'star' %}{%- endfor -%}
          </div>
          <blockquote class="review-text">{{ block.settings.text }}</blockquote>
          <div class="review-author">
            <div class="review-avatar">{{ block.settings.name | slice: 0 }}</div>
            <div class="review-meta">
              <strong>{{ block.settings.name }}</strong>
              <span>{{ block.settings.subtitle }}</span>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Social Proof",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "05 — Bewertungen" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Was unsere Kunden sagen." },
    { "type": "text", "id": "rating", "label": "Bewertung", "default": "4.9 / 5" },
    { "type": "text", "id": "review_count", "label": "Anzahl Bewertungen", "default": "aus 142 Bewertungen" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Bewertung",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Bewertungstext", "default": "Nach jedem Lauf ziehe ich die Boots an. Meine Erholung hat sich massiv verbessert." },
        { "type": "text", "id": "name", "label": "Name", "default": "Markus T." },
        { "type": "text", "id": "subtitle", "label": "Untertitel", "default": "Marathonläufer" }
      ]
    }
  ],
  "presets": [{
    "name": "Social Proof",
    "blocks": [
      { "type": "review", "settings": { "text": "Nach jedem Lauf ziehe ich die Boots an. Meine Erholung hat sich massiv verbessert – ich bin deutlich schneller wieder trainingsbereit.", "name": "Markus T.", "subtitle": "Marathonläufer" } },
      { "type": "review", "settings": { "text": "Ich war skeptisch, aber nach einer Woche war ich überzeugt. Die schweren Beine nach dem Krafttraining sind weg.", "name": "Laura K.", "subtitle": "CrossFit Athletin" } },
      { "type": "review", "settings": { "text": "Endlich eine bezahlbare Alternative zur Physiotherapie. Ich nutze die Boots jeden Abend und schlafe viel besser.", "name": "Stefan M.", "subtitle": "Triathlet" } }
    ]
  }]
}
{% endschema %}
