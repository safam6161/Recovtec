<section class="social" id="social">
  <div class="container">
    <div class="section-head" style="margin-bottom:48px">
      <div class="left">
        <span class="eyebrow" style="display:block;margin-bottom:16px">{{ section.settings.eyebrow }}</span>
        <h2 class="h-2">{{ section.settings.headline }}</h2>
      </div>
      <p style="max-width:36ch;color:var(--mute)">{{ section.settings.subtext }}</p>
    </div>

    <div class="social-grid">
      <div class="social-rating">
        <div class="stars">
          <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 1l2.1 4.6 5 .6-3.7 3.4 1 5-4.4-2.6L3.6 14.6l1-5L.9 6.2l5-.6L8 1z"/></svg>
          <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 1l2.1 4.6 5 .6-3.7 3.4 1 5-4.4-2.6L3.6 14.6l1-5L.9 6.2l5-.6L8 1z"/></svg>
          <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 1l2.1 4.6 5 .6-3.7 3.4 1 5-4.4-2.6L3.6 14.6l1-5L.9 6.2l5-.6L8 1z"/></svg>
          <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 1l2.1 4.6 5 .6-3.7 3.4 1 5-4.4-2.6L3.6 14.6l1-5L.9 6.2l5-.6L8 1z"/></svg>
          <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 1l2.1 4.6 5 .6-3.7 3.4 1 5-4.4-2.6L3.6 14.6l1-5L.9 6.2l5-.6L8 1z"/></svg>
        </div>
        <div>
          <div class="rating-num">{{ section.settings.rating }}</div>
          <div class="rating-meta" style="margin-top:8px">{{ section.settings.review_count }}</div>
        </div>
        <p style="color:var(--mute);font-size:14px;margin:0;max-width:32ch">{{ section.settings.rating_note }}</p>
      </div>

      <div class="testimonial-cards">
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <div class="testimonial" {{ block.shopify_attributes }}>
              <div class="stars">
                <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 1l2.1 4.6 5 .6-3.7 3.4 1 5-4.4-2.6L3.6 14.6l1-5L.9 6.2l5-.6L8 1z"/></svg>
                <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 1l2.1 4.6 5 .6-3.7 3.4 1 5-4.4-2.6L3.6 14.6l1-5L.9 6.2l5-.6L8 1z"/></svg>
                <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 1l2.1 4.6 5 .6-3.7 3.4 1 5-4.4-2.6L3.6 14.6l1-5L.9 6.2l5-.6L8 1z"/></svg>
                <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 1l2.1 4.6 5 .6-3.7 3.4 1 5-4.4-2.6L3.6 14.6l1-5L.9 6.2l5-.6L8 1z"/></svg>
                <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 1l2.1 4.6 5 .6-3.7 3.4 1 5-4.4-2.6L3.6 14.6l1-5L.9 6.2l5-.6L8 1z"/></svg>
              </div>
              <blockquote>{{ block.settings.text }}</blockquote>
              <div class="author">
                <div class="avatar">{{ block.settings.name | slice: 0, 2 | upcase }}</div>
                <div class="author-info">
                  <span class="author-name">{{ block.settings.name }}</span>
                  <span class="author-meta">{{ block.settings.subtitle }}</span>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- if section.settings.show_empty_card -%}
        <div class="testimonial-soon">
          <span class="label">{{ section.settings.empty_label | default: 'Bald hier' }}</span>
          <h4>{{ section.settings.empty_heading | default: 'Dein Erfahrungsbericht' }}</h4>
          <p>{{ section.settings.empty_text | default: 'Wir freuen uns auf deine Bewertung — direkt nach den ersten 2 Wochen. Foto vom Setup gern dabei.' }}</p>
        </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social Proof",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "04 — Stimmen" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Frühe Tester sind überzeugt." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Wir bauen unsere Community gerade auf. Werde Teil davon — und gib uns dein Feedback." },
    { "type": "text", "id": "rating", "label": "Bewertung", "default": "4,9 / 5" },
    { "type": "text", "id": "review_count", "label": "Anzahl", "default": "aus 27 frühen Bewertungen" },
    { "type": "textarea", "id": "rating_note", "label": "Rating-Hinweis", "default": "Wir sammeln Bewertungen erst seit kurzem. Jede Rückmeldung hilft — und wird gelesen." },
    { "type": "header", "content": "Leere Karte" },
    { "type": "checkbox", "id": "show_empty_card", "label": "Leere Karte anzeigen", "default": true },
    { "type": "text", "id": "empty_label", "label": "Karte Label", "default": "Bald hier" },
    { "type": "text", "id": "empty_heading", "label": "Karte Überschrift", "default": "Dein Erfahrungsbericht" },
    { "type": "textarea", "id": "empty_text", "label": "Karte Text", "default": "Wir freuen uns auf deine Bewertung — direkt nach den ersten 2 Wochen. Foto vom Setup gern dabei." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Bewertung",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text", "default": "Bei mir nach jeder langen Einheit Pflicht. Beine fühlen sich am nächsten Tag deutlich frischer an." },
        { "type": "text", "id": "name", "label": "Name", "default": "Jonas K." },
        { "type": "text", "id": "subtitle", "label": "Untertitel", "default": "Triathlon · Hamburg" }
      ]
    }
  ],
  "presets": [{
    "name": "Social Proof",
    "blocks": [
      { "type": "review", "settings": { "text": "Bei mir nach jeder langen Einheit Pflicht. Beine fühlen sich am nächsten Tag deutlich frischer an.", "name": "Jonas K.", "subtitle": "Triathlon · Hamburg" } },
      { "type": "review", "settings": { "text": "Endlich Recovery zuhause, ohne Studio. Leise genug, dass meine Freundin sie kaum hört.", "name": "Lukas M.", "subtitle": "CrossFit · München" } },
      { "type": "review", "settings": { "text": "Bedienung in 30 Sekunden verstanden. Kein App-Quatsch, einfach an und gut.", "name": "Sarah F.", "subtitle": "Marathon · Köln" } }
    ]
  }]
}
{% endschema %}
