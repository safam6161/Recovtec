{% comment %}Modes are now embedded in product-story.liquid{% endcomment %}
<section class="features">
  <div class="container">
    <div class="section-head">
      <div class="left">
        <span class="eyebrow" style="display:block;margin-bottom:16px">{{ section.settings.eyebrow }}</span>
        <h2 class="h-2">{{ section.settings.headline }}</h2>
      </div>
      <p style="max-width:36ch;color:var(--mute)">{{ section.settings.subtext }}</p>
    </div>
    <div class="feature-grid">
      {%- for block in section.blocks -%}
        <div class="feature" {{ block.shopify_attributes }}>
          <span class="num">{{ forloop.index | prepend: '0' }} / {{ block.settings.category }}</span>
          <div class="big">{{ block.settings.big_num }}<span class="u">{{ block.settings.big_unit }}</span></div>
          <div class="spacer"></div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Features",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Technologie" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Mehr als nur Kompression.\nVolle Kontrolle." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Jede Einstellung gezielt für deinen Trainingstag. Von sanftem Cool-Down bis tiefer Regeneration." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "category", "label": "Kategorie", "default": "Druck" },
        { "type": "text", "id": "big_num", "label": "Große Zahl", "default": "240" },
        { "type": "text", "id": "big_unit", "label": "Einheit", "default": "mmHg" },
        { "type": "text", "id": "title", "label": "Titel", "default": "7 Druckstufen" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "30 · 50 · 80 · 120 · 160 · 200 · 240 mmHg. Wir empfehlen Stufe 80 zum Start." }
      ]
    }
  ],
  "presets": [{
    "name": "Product Features",
    "blocks": [
      { "type": "feature", "settings": { "category": "Druck", "big_num": "240", "big_unit": "mmHg", "title": "7 Druckstufen", "text": "30 · 50 · 80 · 120 · 160 · 200 · 240 mmHg. Wir empfehlen Stufe 80 zum Start." } },
      { "type": "feature", "settings": { "category": "Modi", "big_num": "5", "big_unit": "", "title": "Massage-Modi", "text": "Sequenziell, wellenförmig, Peak, Sprint und Recovery — passend zu jeder Einheit." } },
      { "type": "feature", "settings": { "category": "Akku", "big_num": "3", "big_unit": "h", "title": "Komplett kabellos", "text": "Kein Netzkabel, keine App, kein Bluetooth. Anschalten und erholen." } },
      { "type": "feature", "settings": { "category": "Leise", "big_num": "<45", "big_unit": "dB", "title": "Wohnzimmer-tauglich", "text": "Leiser als ein normales Gespräch. Recovery, ohne den Raum zu stören." } }
    ]
  }]
}
{% endschema %}
