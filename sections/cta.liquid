<section class="cta-section">
  <div class="container">
    <div class="cta-inner">
      <h2 class="cta-title">
        BEREIT FÜR<br>
        DEIN NÄCHSTES<br>
        <span class="accent">LEVEL?</span>
      </h2>
      <p class="cta-desc">
        Schließe dich tausenden Athleten an, die mit Recovtec schneller, stärker und erholter trainieren. Dein Körper wird es dir danken.
      </p>
      <div class="cta-actions">
        <a href="{{ section.settings.cta_url | default: routes.collections_url }}" class="btn btn-primary" style="padding: 18px 48px; font-size: 15px;">
          Jetzt bestellen
        </a>
        <a href="{{ section.settings.secondary_url | default: '/pages/faq' }}" class="btn btn-secondary" style="padding: 16px 46px; font-size: 15px;">
          Fragen? FAQ
        </a>
      </div>
      <p class="cta-note">🚚 Kostenloser Versand · 🔄 30 Tage Rückgabe · 🎖 2 Jahre Garantie</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA Section",
  "settings": [
    { "type": "url", "id": "cta_url", "label": "Hauptbutton Link" },
    { "type": "url", "id": "secondary_url", "label": "Zweiter Button Link" }
  ],
  "presets": [{ "name": "CTA Section" }]
}
{% endschema %}
