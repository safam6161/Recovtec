<div class="breadcrumb">
  <div class="container">
    <a href="{{ routes.root_url }}">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 7H2M6 3L2 7l4 4"/></svg>
      {{ section.settings.breadcrumb_back | default: 'Zurück' }}
    </a>
    <span class="sep">/</span>
    <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home | default: 'Startseite' }}</a>
    <span class="sep">/</span>
    <span>{{ product.title }}</span>
  </div>
</div>

<section class="pdp" id="pdp-main">
  <div class="container">
    <div class="pdp-grid">

      <!-- Gallery -->
      <div class="pdp-gallery">
        {%- comment -%} product.media statt product.images, damit auch Videos (und 3D-Modelle) in der Galerie erscheinen {%- endcomment -%}
        {%- assign title_compare = product.title | strip | downcase -%}
        <div class="gallery-main">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              {%- comment -%} Eindeutigen Alt-Text sicherstellen: leere oder generische (= Produkttitel) Alt-Texte durch eine eindeutige Ansicht-Nummer ersetzen; echte, individuell gepflegte Alt-Texte bleiben erhalten {%- endcomment -%}
              {%- assign media_alt = media.alt | strip -%}
              {%- assign media_alt_compare = media_alt | downcase -%}
              {%- if media_alt == blank or media_alt_compare == title_compare -%}
                {%- assign media_alt = product.title | append: ' – Ansicht ' | append: forloop.index -%}
              {%- endif -%}
              <div class="gallery-slide{% if forloop.first %} active{% endif %}" data-media-id="{{ media.id }}"{% unless forloop.first %} hidden{% endunless %}>
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    <img
                      src="{{ media | image_url: width: 1200 }}"
                      width="{{ media.width }}" height="{{ media.height }}"
                      alt="{{ media_alt | escape }}"
                      {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
                  {%- when 'video' -%}
                    {{ media | video_tag: controls: true, playsinline: true, preload: 'metadata', image_size: '1200x' }}
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag }}
                  {%- when 'model' -%}
                    {{ media | model_viewer_tag }}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="placeholder" style="height:100%;min-height:500px">
              <div class="placeholder-label">{{ section.settings.img_placeholder | default: 'RECOVTEC PRO · Frontansicht · auf Modell' }}</div>
            </div>
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="gallery-thumbs">
            {%- for media in product.media -%}
              {%- comment -%} Gleiche Logik wie beim Hauptbild: doppelte oder leere Alt-Texte vermeiden {%- endcomment -%}
              {%- assign thumb_alt = media.alt | strip -%}
              {%- assign thumb_alt_compare = thumb_alt | downcase -%}
              {%- if thumb_alt == blank or thumb_alt_compare == title_compare -%}
                {%- assign thumb_alt = product.title | append: ' – Ansicht ' | append: forloop.index -%}
              {%- endif -%}
              {%- assign is_video = false -%}
              {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                {%- assign is_video = true -%}
              {%- endif -%}
              <button type="button" class="gallery-thumb {% if forloop.first %}active{% endif %}"
                data-media-id="{{ media.id }}"
                aria-label="{% if is_video %}Video{% else %}Bild{% endif %} {{ forloop.index }}">
                {{ media.preview_image | image_url: width: 192 | image_tag: loading: 'lazy', widths: '64, 128, 192', sizes: '64px', alt: thumb_alt }}
                {%- if is_video -%}
                  <span class="gallery-thumb-play" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor"><path d="M3 1.5v9l7.5-4.5z"/></svg>
                  </span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Info -->
      <div class="pdp-info">
        <div class="pdp-info-inner">
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          <h1>{{ product.title }}</h1>
          <p class="lede">{{ section.settings.lede | default: product.description | strip_html | truncate: 160 }}</p>

          {%- if section.settings.benefits != blank -%}
            {%- comment -%} Nutzen-Checkliste: eine Zeile pro Vorteil (Ergebnis statt Technik) {%- endcomment -%}
            {%- assign pdp_benefits = section.settings.benefits | newline_to_br | split: '<br />' -%}
            <ul class="pdp-benefits">
              {%- for item in pdp_benefits -%}
                {%- assign item_text = item | strip -%}
                {%- if item_text != blank -%}
                  {%- comment -%} Teil vor „ — “ wird fett (Kernaussage), der Rest ist die Begründung {%- endcomment -%}
                  {%- assign item_parts = item_text | split: ' — ' -%}
                  <li>{% render 'icon', icon: 'check' %}<span>{% if item_parts.size > 1 %}<strong>{{ item_parts[0] }}</strong> — {{ item_text | remove_first: item_parts[0] | remove_first: ' — ' }}{% else %}{{ item_text }}{% endif %}</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="pdp-price-row">
            <s class="pdp-price-compare" hidden><span class="pdp-sr">Ursprünglicher Preis: </span><span class="pdp-price-compare-val"></span></s>
            <div class="pdp-price" data-price="{{ product.selected_or_first_available_variant.price }}">{{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}</div>
            <div class="pdp-price-meta">{{ section.settings.price_note | default: 'Inkl. MwSt.' }}</div>
          </div>

          {%- if section.settings.inst_show -%}
            {%- liquid
              assign inst_price = product.selected_or_first_available_variant.price
              assign inst_terms = section.settings.inst_terms | default: '3, 6, 12, 24' | split: ','
              assign inst_max_term = 0
              for term in inst_terms
                assign term_num = term | strip | times: 1
                if term_num > inst_max_term
                  assign inst_max_term = term_num
                endif
              endfor
              if inst_max_term > 0
                assign inst_min_rate = inst_price | times: 1.0 | divided_by: inst_max_term | ceil
              endif
            -%}
            <div class="pay-inst">
              <div class="pay-inst-main">
                <div class="pay-inst-brands">
                  <span class="pay-chip pay-chip-paypal"><span>Pay</span>Pal</span>
                </div>
                {%- if section.settings.inst_show_rates and inst_price > 0 and inst_max_term > 0 -%}
                  <p class="pay-inst-rate">
                    <strong>{{ section.settings.inst_zero_label | default: '0 % Zinsen' }}</strong>
                    <span>{{ section.settings.inst_from_label | default: 'schon ab' }} {{ inst_min_rate | money }} {{ section.settings.inst_permonth_label | default: 'pro Monat' }}</span>
                  </p>
                {%- else -%}
                  <p class="pay-inst-rate">
                    <strong>{{ section.settings.inst_norate_label | default: '0 % Finanzierung mit PayPal' }}</strong>
                  </p>
                {%- endif -%}
                <p class="pay-inst-text">{{ section.settings.inst_text | default: 'Mit PayPal in 3, 6, 12 oder 24 Raten zahlen.' }}</p>
              </div>
              <button type="button" class="pay-info-btn pay-info-trigger" aria-label="{{ section.settings.inst_info_aria | default: 'Weitere Informationen zur Ratenzahlung' | escape }}">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M12 11v5.5"/><path d="M12 7.4v.2"/></svg>
                <span>{{ section.settings.inst_info_label | default: 'Weitere Informationen' }}</span>
              </button>
            </div>
          {%- endif -%}

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="size-block">
                <div class="size-head">
                  <span class="label">{{ option.name }} wählen</span>
                  <button type="button" class="size-guide-link size-guide-trigger">{{ section.settings.sg_link_label | default: 'Größentabelle' }} <span aria-hidden="true">↗</span></button>
                </div>
                <div class="size-options">
                  {%- for value in option.values -%}
                    {%- assign variant_for_value = product.variants | where: "option1", value | first -%}
                    <button type="button"
                      class="size-opt {% if option.selected_value == value %}selected{% endif %}"
                      data-variant-id="{{ variant_for_value.id }}"
                      data-price="{{ variant_for_value.price }}"
                      data-option="{{ option.position }}"
                      data-value="{{ value }}">
                      {{ option.name }} {{ value }}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <div class="stock-status">
            {%- if product.selected_or_first_available_variant.available -%}
              <span class="stock-dot" aria-hidden="true"></span>
              <span>{{ section.settings.in_stock_text | default: 'Auf Lager · in 1–3 Werktagen bei dir.' }}</span>
            {%- else -%}
              <span style="color:var(--mute)">{{ section.settings.out_of_stock_text | default: 'Derzeit nicht verfügbar' }}</span>
            {%- endif -%}
          </div>

          {%- if settings.discount_preview_enabled -%}
            <div class="pdp-discount-note" id="pdp-discount-note" role="status" hidden>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 12V4h8l10 10-8 8L3 12z"/><circle cx="7.5" cy="8.5" r="1.4"/></svg>
              <span class="pdp-discount-text"></span>
            </div>
          {%- endif -%}

          <div class="add-row">
            <form id="pdp-atc-form">
              <input type="hidden" name="id" id="pdp-variant-id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="btn btn-primary btn-lg btn-add"
                {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
                {{ section.settings.atc_label | default: 'In den Warenkorb' }}
                <span class="btn-icon"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 7h10M8 3l4 4-4 4"/></svg></span>
              </button>
            </form>
          </div>

          {%- comment -%} EU-Gewährleistungslabel — Pflicht ab 27.09.2026 {%- endcomment -%}
          {% render 'legal-guarantee-label', location: 'product' %}

          {%- if settings.discount_preview_enabled -%}
            {%- comment -%}
              Rabatt-Vorschau: Shopify legt beim Aufruf von /discount/CODE den Cookie
              „discount_code" an. Das Skript läuft synchron direkt nach Preis und Hinweis,
              also vor dem ersten Rendern – dadurch kein Layout-Sprung. Ohne Cookie
              passiert nichts. Abgezogen wird der Rabatt weiterhin von Shopify im Checkout.
            {%- endcomment -%}
            <script>
              (function () {
                try {
                  var cfg = {
                    def: {{ settings.discount_default_percent | default: 20 | json }},
                    list: {{ settings.discount_code_percents | default: '' | json }},
                    onlyListed: {{ settings.discount_only_listed | json }},
                    text: {{ settings.discount_notice_text | default: 'Dein Code [code] ist aktiv – [prozent] % werden automatisch abgezogen.' | json }},
                    moneyFormat: {{ shop.money_format | json }}
                  };

                  var m = document.cookie.match(/(?:^|;\s*)discount_code=([^;]+)/);
                  if (!m) return;
                  var code = m[1];
                  try { code = decodeURIComponent(code.replace(/\+/g, ' ')); } catch (e) {}
                  code = code.trim();
                  // Nur typische Code-Zeichen zulassen – manipulierte Links zeigen nichts an
                  if (!/^[A-Za-z0-9ÄÖÜäöüß_.\-]{1,40}$/.test(code)) return;

                  // Prozent ermitteln: eigener Eintrag in der Liste, sonst Standard
                  var pct = null;
                  cfg.list.split(/\r?\n/).forEach(function (line) {
                    var p = line.match(/^\s*(.+?)\s*[:=]\s*(\d+(?:[.,]\d+)?)\s*%?\s*$/);
                    if (p && p[1].toUpperCase() === code.toUpperCase()) pct = parseFloat(p[2].replace(',', '.'));
                  });
                  if (pct === null) {
                    if (cfg.onlyListed) return;
                    pct = Number(cfg.def);
                  }
                  if (!(pct > 0 && pct < 100)) return;

                  var row = document.querySelector('#pdp-main .pdp-price-row');
                  var priceEl = row && row.querySelector('.pdp-price');
                  var compareEl = row && row.querySelector('.pdp-price-compare');
                  var compareVal = compareEl && compareEl.querySelector('.pdp-price-compare-val');
                  var note = document.getElementById('pdp-discount-note');
                  if (!priceEl || !compareEl || !compareVal || !note) return;

                  // Shop-Währungsformat wie „money_without_trailing_zeros“
                  var decoder = document.createElement('textarea');
                  decoder.innerHTML = cfg.moneyFormat || '';
                  var fmt = decoder.value;
                  function money(cents) {
                    var tag = /\{\{\s*(\w+)\s*\}\}/.exec(fmt);
                    var key = tag ? tag[1] : 'amount_with_comma_separator';
                    var th = ',', dec = '.';
                    if (/comma/.test(key)) { th = '.'; dec = ','; }
                    else if (/space/.test(key)) { th = ' '; dec = ','; }
                    else if (/apostrophe/.test(key)) { th = "'"; dec = '.'; }
                    var parts = (cents / 100).toFixed(2).split('.');
                    var int = parts[0], frac = parts[1];
                    if (/no_decimals/.test(key)) { int = String(Math.round(cents / 100)); frac = '00'; }
                    int = int.replace(/\B(?=(\d{3})+(?!\d))/g, th);
                    var amount = frac === '00' ? int : int + dec + frac;
                    return tag ? fmt.replace(tag[0], amount) : amount + ' €';
                  }

                  var pctLabel = String(pct).replace('.', ',');
                  var sticky = null; // Sticky-Kaufleiste (sections/sticky-buy.liquid), steht weiter unten im DOM
                  var current = priceEl.getAttribute('data-price');
                  function render(cents) {
                    cents = parseInt(cents, 10);
                    if (!(cents > 0)) return;
                    current = cents;
                    // Wie Shopify im Warenkorb/Checkout: Rabattbetrag auf den Cent ABgerundet
                    // (20 % von 499,99 € = 99,998 € → 99,99 € Rabatt → 400 €)
                    var off = Math.floor(cents * pct / 100 + 1e-6);
                    var was = money(cents), now = money(cents - off);
                    compareVal.textContent = was;
                    priceEl.textContent = now;
                    if (sticky) { sticky.was.textContent = was; sticky.now.textContent = now; }
                  }
                  function initSticky() {
                    var now = document.querySelector('[data-sticky-buy][data-mode="pdp"] .sticky-buy-meta strong');
                    if (!now || sticky) return;
                    var was = document.createElement('s');
                    was.className = 'sticky-buy-was';
                    now.parentNode.insertBefore(was, now);
                    sticky = { was: was, now: now };
                    render(current);
                  }

                  render(current);
                  compareEl.hidden = false;
                  row.classList.add('has-discount');

                  // Hinweistext: [code] / [prozent] ersetzen, Code immer als Text (kein HTML)
                  var textEl = note.querySelector('.pdp-discount-text');
                  cfg.text.split(/(\[code\]|\[prozent\])/i).forEach(function (chunk) {
                    if (/^\[code\]$/i.test(chunk)) {
                      var strong = document.createElement('strong');
                      strong.textContent = code;
                      textEl.appendChild(strong);
                    } else if (/^\[prozent\]$/i.test(chunk)) {
                      textEl.appendChild(document.createTextNode(pctLabel));
                    } else if (chunk) {
                      textEl.appendChild(document.createTextNode(chunk));
                    }
                  });
                  note.hidden = false;

                  // Die Leiste ist beim Laden ausgeblendet – Aktualisierung nach dem Parsen springt nicht
                  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initSticky);
                  else initSticky();

                  // Größenwechsel: Preise der gewählten Variante neu berechnen
                  document.querySelectorAll('#pdp-main .size-opt[data-price]').forEach(function (btn) {
                    btn.addEventListener('click', function () { render(btn.getAttribute('data-price')); });
                  });
                } catch (e) {}
              })();
            </script>
          {%- endif -%}

          <div class="pdp-trust-pills">
            {%- if section.settings.trust_1 != blank -%}
              <div class="trust-pill"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 12a8 8 0 0 1 14-5l2-2v6h-6l2.5-2.5"/><path d="M20 12a8 8 0 0 1-14 5l-2 2v-6h6l-2.5 2.5"/></svg><span>{{ section.settings.trust_1 }}</span></div>
            {%- endif -%}
            {%- if section.settings.trust_2 != blank -%}
              <div class="trust-pill"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg><span>{{ section.settings.trust_2 }}</span></div>
            {%- endif -%}
            {%- if section.settings.trust_3 != blank -%}
              <div class="trust-pill"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 7h11v9H2zM13 10h5l3 3v3h-8z"/><circle cx="6" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg><span>{{ section.settings.trust_3 }}</span></div>
            {%- endif -%}
            {%- if section.settings.trust_4 != blank -%}
              <div class="trust-pill"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/></svg><span>{{ section.settings.trust_4 }}</span></div>
            {%- endif -%}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Size Guide Modal -->
<div class="sg-overlay" id="sg-overlay"></div>
<aside class="sg-modal" id="size-guide-modal" role="dialog" aria-label="{{ section.settings.sg_title | default: 'Größentabelle' }}">
  <header class="sg-head">
    <span class="sg-eyebrow">{{ section.settings.sg_title | default: 'Größentabelle' }}</span>
    <button class="sg-close" aria-label="Schließen"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 5l14 14M19 5L5 19"/></svg></button>
  </header>
  <div class="sg-body">
    <div class="sg-brand">{{ section.settings.logo_text | default: 'RECOVTEC' }}</div>
    <p class="sg-intro">{{ section.settings.sg_intro }}</p>
    <h2 class="sg-title">{{ section.settings.sg_heading }}</h2>
    <div class="sg-reco">
      <div class="sg-reco-card">
        <div class="sg-reco-size">{{ section.settings.sg_size1_name | default: 'M' }}</div>
        <div class="sg-reco-meta">
          <span class="sg-reco-label">{{ section.settings.sg_size_label | default: 'Empfohlen für' }}</span>
          <div class="sg-reco-value">{{ section.settings.sg_size1_value | default: 'unter 1,80 m' }}</div>
        </div>
      </div>
      <div class="sg-reco-card">
        <div class="sg-reco-size">{{ section.settings.sg_size2_name | default: 'L' }}</div>
        <div class="sg-reco-meta">
          <span class="sg-reco-label">{{ section.settings.sg_size_label | default: 'Empfohlen für' }}</span>
          <div class="sg-reco-value">{{ section.settings.sg_size2_value | default: 'über 1,80 m' }}</div>
        </div>
      </div>
    </div>
    <div class="sg-facts">
      <div class="sg-fact">
        <span class="sg-fact-num">{{ section.settings.sg_fact1_num | default: '+10' }}<small>{{ section.settings.sg_fact1_unit | default: 'cm' }}</small></span>
        <div class="sg-fact-text">
          <h3>{{ section.settings.sg_fact1_title }}</h3>
          <p>{{ section.settings.sg_fact1_text }}</p>
        </div>
      </div>
      <div class="sg-fact">
        <span class="sg-fact-num">{{ section.settings.sg_fact2_icon | default: '↑' }}</span>
        <div class="sg-fact-text">
          <h3>{{ section.settings.sg_fact2_title }}</h3>
          <p>{{ section.settings.sg_fact2_text }}</p>
        </div>
      </div>
    </div>
  </div>
</aside>

{%- if section.settings.inst_show -%}
<!-- Ratenzahlung Info Modal -->
<div class="sg-overlay" id="pay-overlay"></div>
<aside class="sg-modal pay-modal" id="payment-info-modal" role="dialog" aria-label="{{ section.settings.inst_modal_title | default: 'Ratenzahlung' | escape }}">
  <header class="sg-head">
    <span class="sg-eyebrow">{{ section.settings.inst_modal_title | default: 'Ratenzahlung' }}</span>
    <button class="sg-close" aria-label="Schließen"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 5l14 14M19 5L5 19"/></svg></button>
  </header>
  <div class="sg-body">
    <div class="sg-brand">{{ section.settings.logo_text | default: 'RECOVTEC' }}</div>
    <p class="sg-intro">{{ section.settings.inst_modal_intro }}</p>

    <div class="pay-modal-brands">
      <span class="pay-chip pay-chip-paypal"><span>Pay</span>Pal</span>
    </div>

    {%- liquid
      assign inst_price = product.selected_or_first_available_variant.price
      assign inst_terms = section.settings.inst_terms | default: '3, 6, 12, 24' | split: ','
    -%}
    {%- if section.settings.inst_show_rates and inst_price > 0 and inst_terms.size > 0 -%}
      <h2 class="sg-title">{{ section.settings.inst_table_heading | default: 'Deine Raten mit PayPal' }}</h2>
      <div class="pay-rates">
        {%- for term in inst_terms -%}
          {%- assign term_num = term | strip | times: 1 -%}
          {%- if term_num > 0 -%}
            {%- assign term_rate = inst_price | times: 1.0 | divided_by: term_num | ceil -%}
            <div class="pay-rate">
              <span class="pay-rate-term">{{ term_num }} {{ section.settings.inst_months_label | default: 'Monate' }}</span>
              <span class="pay-rate-amount">{{ term_rate | money }} <small>{{ section.settings.inst_permonth_label | default: 'pro Monat' }}</small></span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.inst_table_note != blank -%}
        <p class="pay-rates-note">{{ section.settings.inst_table_note }}</p>
      {%- endif -%}
    {%- endif -%}

    <h2 class="sg-title">{{ section.settings.inst_modal_heading | default: 'So funktioniert’s' }}</h2>
    <ol class="pay-steps">
      {%- if section.settings.inst_step1 != blank -%}
        <li class="pay-step"><span class="pay-step-num">1</span><div class="pay-step-text"><h3>{{ section.settings.inst_step1 }}</h3><p>{{ section.settings.inst_step1_text }}</p></div></li>
      {%- endif -%}
      {%- if section.settings.inst_step2 != blank -%}
        <li class="pay-step"><span class="pay-step-num">2</span><div class="pay-step-text"><h3>{{ section.settings.inst_step2 }}</h3><p>{{ section.settings.inst_step2_text }}</p></div></li>
      {%- endif -%}
      {%- if section.settings.inst_step3 != blank -%}
        <li class="pay-step"><span class="pay-step-num">3</span><div class="pay-step-text"><h3>{{ section.settings.inst_step3 }}</h3><p>{{ section.settings.inst_step3_text }}</p></div></li>
      {%- endif -%}
    </ol>

    {%- if section.settings.inst_modal_note != blank -%}
      <p class="pay-note">{{ section.settings.inst_modal_note }}</p>
    {%- endif -%}
  </div>
</aside>
{%- endif -%}

