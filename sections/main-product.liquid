<div class="breadcrumb">
  <div class="container">
    <a href="{{ routes.root_url }}">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 7H2M6 3L2 7l4 4"/></svg>
      Zurück
    </a>
    <span class="sep">/</span>
    <a href="{{ routes.root_url }}">Startseite</a>
    <span class="sep">/</span>
    <span>{{ product.title }}</span>
  </div>
</div>

<section class="pdp" id="pdp-main">
  <div class="container">
    <div class="pdp-grid">

      <!-- Gallery -->
      <div class="pdp-gallery">
        <div class="gallery-main">
          {%- if product.featured_image != blank -%}
            <img id="gallery-main-img"
              src="{{ product.featured_image | image_url: width: 1200 }}"
              alt="{{ product.featured_image.alt | escape }}"
              loading="eager" fetchpriority="high">
          {%- else -%}
            <div class="placeholder" style="height:100%;min-height:500px">
              <div class="placeholder-label">RECOVTEC PRO · Frontansicht · auf Modell</div>
            </div>
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="gallery-thumbs five">
            {%- for img in product.images limit: 5 -%}
              <button class="gallery-thumb {% if forloop.first %}active{% endif %}"
                data-src="{{ img | image_url: width: 1200 }}"
                data-alt="{{ img.alt | escape }}"
                aria-label="Bild {{ forloop.index }}">
                <img src="{{ img | image_url: width: 160 }}" alt="{{ img.alt | escape }}" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Info -->
      <div class="pdp-info">
        <div class="pdp-info-inner">
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          <h1>{{ product.title }}</h1>
          <p class="lede">{{ section.settings.lede | default: product.description | strip_html | truncate: 160 }}</p>

          <div class="pdp-price-row">
            <div class="pdp-price">{{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}</div>
            <div class="pdp-price-meta">Inkl. MwSt.</div>
          </div>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="size-block">
                <div class="size-head">
                  <span class="label">{{ option.name }} wählen</span>
                  <button type="button" class="size-guide-link size-guide-trigger">Größentabelle <span aria-hidden="true">↗</span></button>
                </div>
                <div class="size-options">
                  {%- for variant in product.variants -%}
                    {%- if variant.option1 == option.values[forloop.index0] or option.values.size == 1 -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- for value in option.values -%}
                    {%- assign variant_for_value = product.variants | where: "option1", value | first -%}
                    <button type="button"
                      class="size-opt {% if option.selected_value == value %}selected{% endif %}"
                      data-variant-id="{{ variant_for_value.id }}"
                      data-option="{{ option.position }}"
                      data-value="{{ value }}">
                      {{ option.name }} {{ value }}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <div class="stock-status">
            {%- if product.selected_or_first_available_variant.available -%}
              <span class="stock-dot" aria-hidden="true"></span>
              <span><strong>Auf Lager</strong> · in 1–3 Werktagen bei dir.</span>
            {%- else -%}
              <span style="color:var(--mute)">Derzeit nicht verfügbar</span>
            {%- endif -%}
          </div>

          <div class="add-row">
            <form id="pdp-atc-form">
              <input type="hidden" name="id" id="pdp-variant-id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="btn btn-primary btn-lg btn-add"
                {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
                In den Warenkorb
                <span class="btn-icon"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 7h10M8 3l4 4-4 4"/></svg></span>
              </button>
            </form>
          </div>

          <div class="pdp-trust-pills">
            <div class="trust-pill"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 12a8 8 0 0 1 14-5l2-2v6h-6l2.5-2.5"/><path d="M20 12a8 8 0 0 1-14 5l-2 2v-6h6l-2.5 2.5"/></svg><span>30 Tage Geld zurück</span></div>
            <div class="trust-pill"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg><span>1 Jahr Garantie</span></div>
            <div class="trust-pill"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 7h11v9H2zM13 10h5l3 3v3h-8z"/><circle cx="6" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg><span>Kostenloser Versand</span></div>
            <div class="trust-pill"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/></svg><span>Rucksack &amp; Laschen inklusive</span></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Sticky ATC -->
<div class="sticky-atc" id="sticky-atc">
  <div class="container sticky-atc-inner">
    <div class="sticky-prod">
      <div class="sticky-img">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title }}">
        {%- endif -%}
      </div>
      <div class="sticky-meta">
        <div class="sticky-name">{{ product.title }}</div>
        <div class="sticky-price">{{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }} · Größe M</div>
      </div>
    </div>
    <div class="sticky-actions">
      <div class="sticky-size">
        {%- unless product.has_only_default_variant -%}
          {%- for value in product.options_with_values[0].values -%}
            <button class="sticky-size-opt {% if forloop.first %}selected{% endif %}">{{ value }}</button>
          {%- endfor -%}
        {%- endunless -%}
      </div>
      <button class="btn btn-primary" data-sticky-atc>
        In den Warenkorb <span class="btn-icon"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 7h10M8 3l4 4-4 4"/></svg></span>
      </button>
    </div>
  </div>
</div>

<!-- Size Guide Modal -->
<div class="sg-overlay" id="sg-overlay"></div>
<aside class="sg-modal" id="size-guide-modal" role="dialog" aria-label="Größentabelle">
  <header class="sg-head">
    <span class="sg-eyebrow">Größentabelle</span>
    <button class="sg-close" aria-label="Schließen"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 5l14 14M19 5L5 19"/></svg></button>
  </header>
  <div class="sg-body">
    <div class="sg-brand">RECOVTEC</div>
    <p class="sg-intro">Die richtige Größe ist entscheidend für die beste Wirkung deiner Recovtec Recovery Boots. Wir machen es dir einfach — keine komplizierten Messungen, nur deine Körpergröße entscheidet.</p>
    <h3 class="sg-title">Welche Größe<br><strong>passt mir?</strong></h3>
    <div class="sg-reco">
      <div class="sg-reco-card">
        <div class="sg-reco-size">M</div>
        <div class="sg-reco-meta">
          <span class="sg-reco-label">Empfohlen für</span>
          <div class="sg-reco-value">unter 1,80 m</div>
        </div>
      </div>
      <div class="sg-reco-card">
        <div class="sg-reco-size">L</div>
        <div class="sg-reco-meta">
          <span class="sg-reco-label">Empfohlen für</span>
          <div class="sg-reco-value">über 1,80 m</div>
        </div>
      </div>
    </div>
    <div class="sg-facts">
      <div class="sg-fact">
        <span class="sg-fact-num">+10<small>cm</small></span>
        <div class="sg-fact-text">
          <h4>+10 cm Bein-Erweiterung inklusive</h4>
          <p>Mit den beigelieferten Erweiterungslaschen ist bei <strong>beiden Größen</strong> ein zusätzlicher Spielraum von 10 cm am <strong>ganzen Bein</strong> möglich.</p>
        </div>
      </div>
      <div class="sg-fact">
        <span class="sg-fact-num">↑</span>
        <div class="sg-fact-text">
          <h4>Zwischen zwei Größen?</h4>
          <p>Wer sich nicht ganz entscheiden kann, dem empfehlen wir die <strong>größere Variante</strong>.</p>
        </div>
      </div>
    </div>
  </div>
</aside>

{% schema %}
{
  "name": "Produkt",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Recovtec — Recovery" },
    { "type": "textarea", "id": "lede", "label": "Kurzbeschreibung", "default": "Pneumatische Recovery Boots für aktive Muskelregeneration. Kabellos, leise, mit 5 Modi und 7 fein abgestuften Druckstufen bis 240 mmHg." }
  ],
  "presets": [{ "name": "Produkt" }]
}
{% endschema %}
