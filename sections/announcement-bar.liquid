<div class="announce">
  <div class="announce-track">
    {%- for block in section.blocks -%}
      {%- unless forloop.first -%}<span class="dot"></span>{%- endunless -%}
      <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "blocks": [
    {
      "type": "item",
      "name": "Punkt",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Kostenloser Versand" }
      ]
    }
  ],
  "presets": [{
    "name": "Announcement Bar",
    "blocks": [
      { "type": "item", "settings": { "text": "Kostenloser Versand" } },
      { "type": "item", "settings": { "text": "30 Tage Geld zurück" } },
      { "type": "item", "settings": { "text": "1 Jahr Garantie" } }
    ]
  }]
}
{% endschema %}
