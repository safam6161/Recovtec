<section class="solution" id="solution">
  <div class="container">
    <div class="solution-head">
      <div>
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.headline }}</h2>
      </div>
      <p>{{ section.settings.subtext }}</p>
    </div>

    <div class="usp-grid">
      <div class="usp usp-image">
        <div class="ph">
          {%- assign product_image_src = section.settings.product_image | image_url: width: 800 -%}
          {%- if product_image_src != blank -%}
            {{ product_image_src | image_tag: alt: 'Recovtec Pro Recovery Boots' }}
          {%- elsif section.settings.product_image_url != blank -%}
            <img src="{{ section.settings.product_image_url }}" alt="Recovtec Pro Recovery Boots" loading="lazy">
          {%- else -%}
            <div class="placeholder dark"><div class="placeholder-label">PRODUKTBILD · Recovery Boots Frontansicht · auf transparentem oder dunklem Hintergrund · 4:5</div></div>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        <div class="usp {% if forloop.last and section.blocks.size == 3 %}usp-wide{% endif %}" {{ block.shopify_attributes }}>
          <div class="big">{{ block.settings.big_num }}<span class="u">{{ block.settings.big_unit }}</span></div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          {%- if block.settings.cta_label != blank -%}
            <a href="{{ block.settings.cta_url | default: '#howto' }}" class="cta-link">{{ block.settings.cta_label }} <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 7h10M8 3l4 4-4 4"/></svg></a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="solution-foot">
      <p>{{ section.settings.footnote }}</p>
      <a href="{{ section.settings.cta_url | default: routes.collections_url }}" class="btn btn-primary btn-lg">
        {{ section.settings.cta_label }}
        <span class="btn-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 9h14M11 4l5 5-5 5"/></svg></span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Solution",
  "settings": [
    { "type": "image_picker", "id": "product_image", "label": "Produktbild" },
    { "type": "text", "id": "product_image_url", "label": "Produktbild URL (Fallback)", "info": "Wird genutzt wenn kein Produktbild ausgewählt ist." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "02 — Die Lösung" },
    { "type": "textarea", "id": "headline", "label": "Headline", "default": "Recovery Boots.\nIm Wohnzimmer. Sofort." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Pneumatische Kompression in 5 Modi und 7 fein abgestuften Druckstufen — komplett kabellos, flüsterleise, ohne App-Quatsch. Anziehen, einschalten, erholen." },
    { "type": "text", "id": "footnote", "label": "Fußnote", "default": "1 Jahr Garantie · 30 Tage Geld-zurück-Garantie · Kostenloser Versand in 1–3 Werktagen." },
    { "type": "text", "id": "cta_label", "label": "Button Text", "default": "Zum Produkt" },
    { "type": "url", "id": "cta_url", "label": "Button Link" }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        { "type": "text", "id": "big_num", "label": "Große Zahl", "default": "7" },
        { "type": "text", "id": "big_unit", "label": "Einheit", "default": "Stufen" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Volle Kontrolle über deine Recovery" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "5 Massagemodi und 7 Druckstufen von 30 bis 240 mmHg." },
        { "type": "text", "id": "cta_label", "label": "Link Text" },
        { "type": "url", "id": "cta_url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [{
    "name": "Solution",
    "blocks": [
      { "type": "usp", "settings": { "big_num": "7", "big_unit": "Stufen", "title": "Volle Kontrolle über deine Recovery", "text": "5 Massagemodi und 7 Druckstufen von 30 bis 240 mmHg. Sanftes Cool-Down oder Tiefen-Regeneration — alles in einem Gerät." } },
      { "type": "usp", "settings": { "big_num": "3", "big_unit": "Stunden Akku", "title": "Kabellos. Keine App.", "text": "Komplett akkubetrieben, leiser als 45 dB, mit LED-Controller direkt am Bein. Anziehen, drücken, fertig. Auch unterwegs." } },
      { "type": "usp", "settings": { "big_num": "3", "big_unit": "Teile im Paket", "title": "Alles dabei. Sofort startklar.", "text": "Recovery Boots, ein hochwertiger Transport-Rucksack und Erweiterungslaschen für unterschiedliche Beingrößen. Im Paket enthalten — ohne Aufpreis, ohne Zusatzbestellung.", "cta_label": "So funktioniert's", "cta_url": "#howto" } }
    ]
  }]
}
{% endschema %}
