<section style="padding:80px 24px;max-width:1200px;margin:0 auto">
  <h1 style="font-size:clamp(24px,3vw,36px);font-weight:700;margin-bottom:40px">{{ collection.title }}</h1>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:24px">
    {%- for product in collection.products -%}
      <a href="{{ product.url }}" style="display:block;text-decoration:none;color:inherit">
        <div style="aspect-ratio:1;background:var(--paper-2);margin-bottom:12px;overflow:hidden">
          {%- if product.featured_image -%}
            {{ product.featured_image | image_tag: loading: 'lazy', widths: '260, 400, 520, 780', sizes: '(min-width: 750px) 260px, 50vw', style: 'width:100%;height:100%;object-fit:cover', alt: product.featured_image.alt }}
          {%- endif -%}
        </div>
        <p style="font-weight:600;margin-bottom:4px">{{ product.title }}</p>
        <p style="color:var(--mute)">{{ product.price | money }}</p>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{ "name": "Kollektion" }
{% endschema %}
