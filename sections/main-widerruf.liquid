<section class="widerruf">
  <div class="container widerruf-inner">

    <header class="widerruf-head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h1 class="widerruf-title">{{ section.settings.headline }}</h1>
      {%- if section.settings.intro != blank -%}
        <div class="widerruf-intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    <div class="widerruf-form-wrap">
      {% form 'contact', class: 'widerruf-form' %}
        {%- if form.posted_successfully? -%}
          <div class="widerruf-success">
            <strong>{{ section.settings.success_title | default: 'Widerruf eingegangen.' }}</strong>
            <p>{{ section.settings.success_text | default: 'Wir haben deinen Widerruf erhalten und bestätigen ihn dir per E-Mail.' }}</p>
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="widerruf-errors">
            {%- for field in form.errors -%}
              <p>{{ form.errors.messages[field] }}</p>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} Kennzeichnet die Zuschrift im Postfach eindeutig als Widerruf {%- endcomment -%}
        <input type="hidden" name="contact[subject]" value="Widerruf – Vertragswiderruf über die Website">

        <div class="widerruf-row">
          <label>
            <span>Name des Verbrauchers *</span>
            <input type="text" name="contact[name]" required value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
          </label>
          <label>
            <span>E-Mail *</span>
            <input type="email" name="contact[email]" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
          </label>
        </div>

        <label class="widerruf-full">
          <span>Anschrift des Verbrauchers *</span>
          <input type="text" name="contact[Anschrift]" required placeholder="Straße, PLZ, Ort">
        </label>

        <div class="widerruf-row">
          <label>
            <span>Bestellnummer</span>
            <input type="text" name="contact[Bestellnummer]" placeholder="z. B. #1234">
          </label>
          <label>
            <span>Bestellte / erhaltene Ware *</span>
            <input type="text" name="contact[Ware]" required placeholder="z. B. Recovery Boots Pro, Größe L">
          </label>
        </div>

        <div class="widerruf-row">
          <label>
            <span>Bestellt am</span>
            <input type="date" name="contact[Bestelldatum]">
          </label>
          <label>
            <span>Erhalten am</span>
            <input type="date" name="contact[Erhaltsdatum]">
          </label>
        </div>

        <label class="widerruf-full">
          <span>Anmerkung (optional)</span>
          <textarea name="contact[body]" rows="4" placeholder="Optionale Anmerkung – ein Grund ist nicht erforderlich.">{{ form.body }}</textarea>
        </label>

        <label class="widerruf-consent">
          <input type="checkbox" name="contact[Bestaetigung]" value="Ja – Vertrag wird hiermit widerrufen" required>
          <span>{{ section.settings.consent_text | default: 'Hiermit widerrufe ich den oben genannten Vertrag.' }}</span>
        </label>

        <button type="submit" class="btn btn-primary">
          {{ section.settings.submit_label | default: 'Widerruf absenden' }}
        </button>
      {% endform %}
    </div>

  </div>
</section>

<style>
  .widerruf { padding: clamp(48px,6vw,96px) 0; background: var(--paper); }
  .widerruf-inner { max-width: 760px; }
  .widerruf-head { margin-bottom: clamp(28px,4vw,48px); }
  .widerruf-title { font-family: var(--f-display); font-size: clamp(28px,3.5vw,44px); font-weight: 700; line-height: 1.1; letter-spacing: -0.02em; margin: 12px 0 16px; }
  .widerruf-intro { font-size: 15px; color: var(--mute); line-height: 1.6; }
  .widerruf-intro p { margin-bottom: 10px; }
  .widerruf-form { display: flex; flex-direction: column; gap: 16px; }
  .widerruf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .widerruf-form label { display: flex; flex-direction: column; gap: 6px; }
  .widerruf-form label span { font-family: var(--f-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mute); }
  .widerruf-form input, .widerruf-form textarea {
    width: 100%; padding: 12px 14px; font: inherit; font-size: 15px;
    background: var(--paper); color: var(--ink);
    border: 1px solid var(--line-2);
    border-radius: 0;
  }
  .widerruf-form input:focus, .widerruf-form textarea:focus { outline: none; border-color: var(--ink); }
  .widerruf-form textarea { resize: vertical; min-height: 90px; }
  .widerruf-consent { flex-direction: row !important; align-items: flex-start; gap: 10px !important; }
  .widerruf-consent input { width: auto; margin-top: 3px; }
  .widerruf-consent span { text-transform: none !important; font-family: var(--f-ui) !important; font-size: 14px !important; color: var(--ink) !important; letter-spacing: 0 !important; line-height: 1.5; }
  .widerruf-form .btn { align-self: flex-start; margin-top: 8px; }
  .widerruf-success { padding: 16px 18px; background: #e9f7ee; border: 1px solid #b6e1c5; color: #1a5f37; }
  .widerruf-success strong { display: block; margin-bottom: 4px; }
  .widerruf-errors { padding: 14px 18px; background: #fdecec; border: 1px solid #f3b8b8; color: #8a1c1c; font-size: 14px; }
  @media (max-width:880px) {
    .widerruf-row { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Widerruf",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Widerruf" },
    { "type": "text", "id": "headline", "label": "Überschrift", "default": "Vertrag widerrufen" },
    { "type": "richtext", "id": "intro", "label": "Einleitungstext", "default": "<p>Du möchtest deinen Kauf widerrufen? Fülle einfach das folgende Formular aus – ein Grund ist nicht erforderlich. Nach dem Absenden erhältst du eine Bestätigung per E-Mail. Details findest du in unserer Widerrufsbelehrung.</p>" },
    { "type": "text", "id": "consent_text", "label": "Bestätigungstext (Checkbox)", "default": "Hiermit widerrufe ich den oben genannten Vertrag." },
    { "type": "text", "id": "submit_label", "label": "Button-Text", "default": "Widerruf absenden" },
    { "type": "header", "content": "Erfolgsmeldung" },
    { "type": "text", "id": "success_title", "label": "Titel", "default": "Widerruf eingegangen." },
    { "type": "textarea", "id": "success_text", "label": "Text", "default": "Wir haben deinen Widerruf erhalten und bestätigen ihn dir per E-Mail." }
  ],
  "presets": [{ "name": "Widerruf" }]
}
{% endschema %}
