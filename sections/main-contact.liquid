<section class="contact">
  <div class="container contact-inner">

    <header class="contact-head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h1 class="contact-title">{{ section.settings.headline }}</h1>
      {%- if section.settings.subtext != blank -%}
        <p class="contact-sub">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </header>

    <div class="contact-grid">

      <div class="contact-form-wrap">
        {% form 'contact', class: 'contact-form' %}
          {%- if form.posted_successfully? -%}
            <div class="contact-success">
              <strong>{{ section.settings.success_title | default: 'Danke!' }}</strong>
              <p>{{ section.settings.success_text | default: 'Wir melden uns innerhalb eines Werktags.' }}</p>
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="contact-errors">
              {%- for field in form.errors -%}
                <p>{{ form.errors.messages[field] }}</p>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div class="contact-row">
            <label>
              <span>Name</span>
              <input type="text" name="contact[name]" required value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
            </label>
            <label>
              <span>E-Mail</span>
              <input type="email" name="contact[email]" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
            </label>
          </div>

          <label class="contact-full">
            <span>Betreff</span>
            <input type="text" name="contact[subject]" value="{{ form.subject }}">
          </label>

          <label class="contact-full">
            <span>Nachricht</span>
            <textarea name="contact[body]" rows="6" required>{{ form.body }}</textarea>
          </label>

          <button type="submit" class="btn btn-primary">
            {{ section.settings.submit_label | default: 'Nachricht senden' }}
          </button>
        {% endform %}
      </div>

      <aside class="contact-side">
        <div class="contact-card">
          <h3>{{ section.settings.support_title | default: 'Support' }}</h3>
          <p class="contact-card-text">{{ section.settings.support_text }}</p>
          {%- if section.settings.email_general != blank -%}
            <a class="contact-mail" href="mailto:{{ section.settings.email_general }}">
              <span>Allgemein</span>
              <strong>{{ section.settings.email_general }}</strong>
            </a>
          {%- endif -%}
          {%- if section.settings.email_support != blank -%}
            <a class="contact-mail" href="mailto:{{ section.settings.email_support }}">
              <span>Support &amp; Bestellungen</span>
              <strong>{{ section.settings.email_support }}</strong>
            </a>
          {%- endif -%}
          {%- if section.settings.email_returns != blank -%}
            <a class="contact-mail" href="mailto:{{ section.settings.email_returns }}">
              <span>Rückgaben</span>
              <strong>{{ section.settings.email_returns }}</strong>
            </a>
          {%- endif -%}
        </div>

        {%- if section.settings.hours_text != blank -%}
          <div class="contact-card">
            <h3>{{ section.settings.hours_title | default: 'Antwortzeit' }}</h3>
            <p class="contact-card-text">{{ section.settings.hours_text }}</p>
          </div>
        {%- endif -%}
      </aside>

    </div>
  </div>
</section>

<style>
  .contact { padding: clamp(48px,6vw,96px) 0; background: var(--paper); }
  .contact-head { max-width: 680px; margin-bottom: clamp(32px,4vw,56px); }
  .contact-title { font-family: var(--f-display); font-size: clamp(28px,3.5vw,44px); font-weight: 700; line-height: 1.1; letter-spacing: -0.02em; margin: 12px 0 16px; }
  .contact-sub { font-size: 15px; color: var(--mute); line-height: 1.6; max-width: 56ch; }
  .contact-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(32px,4vw,64px); align-items: start; }
  .contact-form { display: flex; flex-direction: column; gap: 16px; }
  .contact-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .contact-form label { display: flex; flex-direction: column; gap: 6px; }
  .contact-form label span { font-family: var(--f-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mute); }
  .contact-form input, .contact-form textarea {
    width: 100%; padding: 12px 14px; font: inherit; font-size: 15px;
    background: var(--paper); color: var(--ink);
    border: 1px solid var(--line-2);
    border-radius: 0;
  }
  .contact-form input:focus, .contact-form textarea:focus { outline: none; border-color: var(--ink); }
  .contact-form textarea { resize: vertical; min-height: 140px; }
  .contact-form .btn { align-self: flex-start; margin-top: 8px; }
  .contact-success { padding: 16px 18px; background: #e9f7ee; border: 1px solid #b6e1c5; color: #1a5f37; }
  .contact-success strong { display: block; margin-bottom: 4px; }
  .contact-errors { padding: 14px 18px; background: #fdecec; border: 1px solid #f3b8b8; color: #8a1c1c; font-size: 14px; }
  .contact-side { display: flex; flex-direction: column; gap: 16px; }
  .contact-card { padding: 24px; background: var(--paper-2); border: 1px solid var(--line); }
  .contact-card h3 { font-family: var(--f-display); font-size: 16px; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 12px; }
  .contact-card-text { font-size: 14px; color: var(--mute); line-height: 1.6; margin-bottom: 16px; }
  .contact-card-text:last-child { margin-bottom: 0; }
  .contact-mail {
    display: flex; flex-direction: column; gap: 2px;
    padding: 12px 0; border-top: 1px solid var(--line);
    text-decoration: none; color: var(--ink);
    transition: opacity 0.15s;
  }
  .contact-mail:first-of-type { border-top: 1px solid var(--line); }
  .contact-mail:hover { opacity: 0.7; }
  .contact-mail span { font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mute); }
  .contact-mail strong { font-size: 14px; font-weight: 600; word-break: break-all; }
  @media (max-width:880px) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-row { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Kontakt",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Kontakt" },
    { "type": "text", "id": "headline", "label": "Überschrift", "default": "Wir sind für dich da." },
    { "type": "textarea", "id": "subtext", "label": "Untertext", "default": "Fragen zur Bestellung, Größenberatung oder zu unseren Produkten? Schreib uns — meistens antworten wir innerhalb eines Werktages." },
    { "type": "text", "id": "submit_label", "label": "Button-Text", "default": "Nachricht senden" },
    { "type": "header", "content": "Erfolgsmeldung" },
    { "type": "text", "id": "success_title", "label": "Titel", "default": "Danke!" },
    { "type": "textarea", "id": "success_text", "label": "Text", "default": "Wir melden uns innerhalb eines Werktages." },
    { "type": "header", "content": "Support-E-Mails" },
    { "type": "text", "id": "support_title", "label": "Karten-Titel", "default": "Support" },
    { "type": "textarea", "id": "support_text", "label": "Karten-Text", "default": "Schreib uns direkt — wir antworten persönlich und ehrlich." },
    { "type": "text", "id": "email_general", "label": "Allgemeine E-Mail", "default": "info@recovtec.de" },
    { "type": "text", "id": "email_support", "label": "Support / Bestellungen", "default": "support@recovtec.de" },
    { "type": "text", "id": "email_returns", "label": "Rückgaben (optional)", "default": "" },
    { "type": "header", "content": "Antwortzeit-Karte (optional)" },
    { "type": "text", "id": "hours_title", "label": "Titel", "default": "Antwortzeit" },
    { "type": "textarea", "id": "hours_text", "label": "Text", "default": "Mo – Fr · 9 – 17 Uhr · Antwort innerhalb eines Werktages." }
  ],
  "presets": [{ "name": "Kontakt" }]
}
{% endschema %}
