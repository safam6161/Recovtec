<footer class="footer">
  <div class="container">
    <div class="foot-top">
      <div class="foot-brand">
        <a href="{{ routes.root_url }}" class="nav-logo" style="color:var(--paper)">
          <span class="mark"></span>
          RECOVTEC
        </a>
        <p>{{ section.settings.tagline }}</p>
      </div>
    </div>
    <div class="foot-bottom">
      <div>{{ section.settings.legal }}</div>
      <div class="lr">
        <span>{{ section.settings.shipping_note }}</span>
        <span>{{ section.settings.payment_note }}</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Eigenmarke fuer professionelle Recovery. Faire Preise, volle Ausstattung, ehrlich kalkuliert." },
    { "type": "text", "id": "legal", "label": "Copyright", "default": "(c) 2026 Recovtec - Deutschland" },
    { "type": "text", "id": "shipping_note", "label": "Versand-Hinweis", "default": "Versand mit DHL" },
    { "type": "text", "id": "payment_note", "label": "Zahlungs-Hinweis", "default": "Zahlung: Klarna, Visa, Mastercard, PayPal" }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
