<style>
  .foot-logo {
    display:flex; align-items:center; gap:8px;
    font-family:var(--f-display); font-size:15px; font-weight:700;
    letter-spacing:0.08em; text-transform:uppercase;
    color:var(--paper); text-decoration:none;
    margin-bottom:16px;
  }
  .foot-widerruf-row { padding-top: 24px; }
  .foot-widerruf {
    display:inline-flex; align-items:center; gap:8px;
    padding:12px 22px; border:1px solid rgba(255,255,255,0.45);
    font-family:var(--f-ui); font-size:13px; font-weight:600; letter-spacing:0.03em; text-transform:uppercase;
    color:var(--paper); text-decoration:none;
    transition:background .15s, color .15s, border-color .15s;
  }
  .foot-widerruf:hover { background:var(--paper); color:var(--ink); border-color:var(--paper); }
</style>

<footer class="footer">
  <div class="container">
    <div class="foot-top">
      <div class="foot-brand">
        <a href="{{ routes.root_url }}" class="foot-logo">
          <span class="mark"></span>
          RECOVTEC
        </a>
        <p style="text-align:left">{{ section.settings.tagline }}</p>
      </div>

      {%- if section.settings.menu_company != blank -%}
        <div class="foot-col">
          <h5>{{ section.settings.col2_heading }}</h5>
          <ul>
            {%- for link in linklists[section.settings.menu_company].links -%}
              {%- assign link_title = link.title | downcase | strip -%}
              {%- unless link_title == 'über uns' -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endunless -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.widerruf_url != blank -%}
      <div class="foot-widerruf-row">
        <a class="foot-widerruf" href="{{ section.settings.widerruf_url }}">{{ section.settings.widerruf_label | default: 'Vertrag widerrufen' }}</a>
      </div>
    {%- endif -%}

    <div class="foot-bottom">
      <div>{{ section.settings.legal }}</div>
      <div class="lr">
        <span>{{ section.settings.shipping_note }}</span>
        <span>{{ section.settings.payment_note }}</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Eigenmarke für professionelle Recovery. Faire Preise, volle Ausstattung, ehrlich kalkuliert." },
    { "type": "header", "content": "Spalte Unternehmen" },
    { "type": "text", "id": "col2_heading", "label": "Ueberschrift", "default": "Unternehmen" },
    { "type": "link_list", "id": "menu_company", "label": "Menue Unternehmen" },
    { "type": "header", "content": "Fusszeile" },
    { "type": "text", "id": "legal", "label": "Copyright", "default": "(c) 2026 Recovtec - Deutschland" },
    { "type": "text", "id": "shipping_note", "label": "Versand-Hinweis", "default": "Versand mit DHL" },
    { "type": "text", "id": "payment_note", "label": "Zahlungs-Hinweis", "default": "Zahlung: Klarna, Visa, Mastercard, PayPal" },
    { "type": "header", "content": "Widerrufsbutton (Pflicht ab 19.06.2026)" },
    { "type": "text", "id": "widerruf_label", "label": "Widerruf-Button Text", "default": "Vertrag widerrufen" },
    { "type": "text", "id": "widerruf_url", "label": "Widerruf-Button Link", "default": "/pages/widerruf" }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
