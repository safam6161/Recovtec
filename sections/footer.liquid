<style>
  .foot-logo {
    display:flex; align-items:center; gap:8px;
    font-family:var(--f-display); font-size:15px; font-weight:700;
    letter-spacing:0.08em; text-transform:uppercase;
    color:var(--paper); text-decoration:none;
    margin-bottom:16px;
  }
  .foot-widerruf-btn {
    height:48px; padding:0 28px;
    background:transparent; color:var(--paper);
    border:1px solid rgba(255,255,255,0.25);
  }
  .foot-widerruf-btn:hover {
    background:var(--paper); color:#111;
    transform:translateY(-1px);
  }
</style>

<footer class="footer">
  <div class="container">
    <div class="foot-top">
      <div class="foot-brand">
        <a href="{{ routes.root_url }}" class="foot-logo">
          <span class="mark"></span>
          RECOVTEC
        </a>
        <p style="text-align:left">{{ section.settings.tagline }}</p>
      </div>

      {%- if section.settings.menu_service != blank -%}
        <div class="foot-col">
          <h5>{{ section.settings.col1_heading }}</h5>
          <ul>
            {%- for link in linklists[section.settings.menu_service].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if section.settings.menu_company != blank -%}
        <div class="foot-col">
          <h5>{{ section.settings.col2_heading }}</h5>
          <ul>
            {%- for link in linklists[section.settings.menu_company].links -%}
              {%- assign link_title = link.title | downcase | strip -%}
              {%- unless link_title == 'über uns' -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endunless -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.widerruf_url != blank -%}
      <div class="foot-widerruf" style="margin-top:24px;">
        <a href="{{ section.settings.widerruf_url }}" class="btn foot-widerruf-btn">
          {{ section.settings.widerruf_label }}
        </a>
      </div>
    {%- endif -%}

    <div class="foot-bottom">
      <div>{{ section.settings.legal }}</div>
      <div class="lr">
        <span>{{ section.settings.shipping_note }}</span>
        <span>{{ section.settings.payment_note }}</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Eigenmarke für professionelle Recovery. Faire Preise, volle Ausstattung, ehrlich kalkuliert." },
    { "type": "header", "content": "Spalte 1 - Service" },
    { "type": "text", "id": "col1_heading", "label": "Ueberschrift Spalte 1", "default": "Service" },
    { "type": "link_list", "id": "menu_service", "label": "Menue Spalte 1" },
    { "type": "header", "content": "Spalte 2 - Unternehmen" },
    { "type": "text", "id": "col2_heading", "label": "Ueberschrift Spalte 2", "default": "Unternehmen" },
    { "type": "link_list", "id": "menu_company", "label": "Menue Spalte 2" },
    { "type": "header", "content": "Widerruf-Button" },
    { "type": "text", "id": "widerruf_label", "label": "Button-Text", "default": "Vertrag widerrufen" },
    { "type": "url", "id": "widerruf_url", "label": "Button-Ziel (Seite waehlen)", "info": "Auf existierende Seite zeigen lassen, z.B. Widerrufsbelehrung. Leer lassen = Button ausgeblendet." },
    { "type": "header", "content": "Fusszeile" },
    { "type": "text", "id": "legal", "label": "Copyright", "default": "(c) 2026 Recovtec - Deutschland" },
    { "type": "text", "id": "shipping_note", "label": "Versand-Hinweis", "default": "Versand mit DHL" },
    { "type": "text", "id": "payment_note", "label": "Zahlungs-Hinweis", "default": "Zahlung: Klarna, Visa, Mastercard, PayPal" }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
