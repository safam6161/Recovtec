<footer class="footer">
  <div class="container">
    <div class="foot-top">
      <div class="foot-brand">
        <a href="{{ routes.root_url }}" class="nav-logo" style="color:var(--paper)">
          <span class="mark"></span>
          RECOVTEC
        </a>
        <p>{{ section.settings.tagline }}</p>
      </div>
      {%- for block in section.blocks -%}
        <div class="foot-col" {{ block.shopify_attributes }}>
          <h5>{{ block.settings.heading }}</h5>
          <ul>
            {%- assign labels = block.settings.labels | split: '|' -%}
            {%- assign links = block.settings.links | split: '|' -%}
            {%- for label in labels -%}
              <li><a href="{{ links[forloop.index0] | default: '#' }}">{{ label }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
    <div class="foot-bottom">
      <div>{{ section.settings.legal }}</div>
      <div class="lr">
        <span>Versand mit DHL</span>
        <span>Zahlung: Klarna · Visa · Mastercard · PayPal</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Eigenmarke für professionelle Recovery. Faire Preise, volle Ausstattung, ehrlich kalkuliert." },
    { "type": "text", "id": "legal", "label": "Copyright", "default": "© 2026 Recovtec · Deutschland" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Spalte",
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Shop" },
        { "type": "textarea", "id": "labels", "label": "Link-Labels (| getrennt)", "default": "Recovery Boots|Bald: Massagepistole|Zubehör" },
        { "type": "textarea", "id": "links", "label": "Link-URLs (| getrennt)", "default": "/collections/all|#|#" }
      ]
    }
  ],
  "presets": [{
    "name": "Footer",
    "blocks": [
      { "type": "column", "settings": { "heading": "Shop", "labels": "Recovery Boots|Bald: Massagepistole|Zubehör", "links": "/collections/all|#|#" } },
      { "type": "column", "settings": { "heading": "Service", "labels": "Versand & Lieferung|Rückgabe|Garantie|Größenberater", "links": "/pages/versand|/pages/rueckgabe|/pages/garantie|#" } },
      { "type": "column", "settings": { "heading": "Unternehmen", "labels": "Über Recovtec|Kontakt|Impressum|Datenschutz|AGB", "links": "/pages/ueber-uns|/pages/kontakt|/pages/impressum|/pages/datenschutz|/pages/agb" } }
    ]
  }]
}
{% endschema %}
