{%- comment -%}
  Judge.me Bewertungen im Shop-Design
  -----------------------------------
  Der Widget-Container unten stammt unverändert aus der manuellen
  Judge.me-Installation (data-auto-install='false'). Struktur, Klassen und
  data-Attribute dürfen NICHT angepasst werden — sonst findet das
  Judge.me-Skript das Widget nicht mehr und es bleibt leer.

  Die Optik kommt deshalb ausschließlich von außen:
    - diese Section-Hülle (Container, Eyebrow, Headline wie in „Social Proof")
    - die Regeln unter „Judge.me Bewertungen" in assets/theme.css

  Voraussetzung: Die App-Einbettung „Judge.me Core" muss unter
  Theme-Einstellungen → App-Einbettungen aktiv sein, sonst lädt das Skript
  nicht. Sie ist in config/settings_data.json bereits eingetragen.
{%- endcomment -%}

{%- liquid
  comment
    Auf der Produktseite liefert Shopify 'product'. Auf anderen Seiten (z. B.
    Startseite) gibt es das nicht — dort muss das Produkt im Theme-Editor
    gewählt werden. Ohne Produkt wird die Section nicht ausgegeben.
  endcomment
  assign jm_product = section.settings.product | default: product

  assign jm_classes = 'jm-reviews'
  if section.settings.bg == 'paper_2'
    assign jm_classes = jm_classes | append: ' jm-reviews--alt'
  endif
  if section.settings.hide_widget_title
    assign jm_classes = jm_classes | append: ' jm-reviews--no-widget-title'
  endif
  if section.settings.hide_review_date
    assign jm_classes = jm_classes | append: ' jm-reviews--no-date'
  endif
  if section.settings.hide_review_count
    assign jm_classes = jm_classes | append: ' jm-reviews--no-count'
  endif
  if section.settings.show_avg_stars
    assign jm_classes = jm_classes | append: ' jm-reviews--avg-stars'
  endif
  if section.settings.hide_media_gallery
    assign jm_classes = jm_classes | append: ' jm-reviews--no-media-gallery'
  endif
-%}

{%- if jm_product == blank -%}
  {%- if request.design_mode -%}
    <section class="jm-reviews"><div class="container">
      <p class="jm-reviews-sub">Bitte im Theme-Editor unter „Produkt" das Produkt auswählen, dessen Bewertungen hier erscheinen sollen.</p>
    </div></section>
  {%- endif -%}
{%- else -%}
<section class="{{ jm_classes }}" id="reviews">
  <div class="container">
    {%- liquid
      assign has_eyebrow = false
      assign has_headline = false
      assign has_subtext = false
      if section.settings.eyebrow != blank
        assign has_eyebrow = true
      endif
      if section.settings.headline != blank
        assign has_headline = true
      endif
      if section.settings.subtext != blank
        assign has_subtext = true
      endif
    -%}

    {%- if has_eyebrow or has_headline or has_subtext -%}
      <div class="section-head">
        <div class="left">
          {%- if has_eyebrow -%}
            <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if has_headline -%}
            <h2 class="h-2">{{ section.settings.headline }}</h2>
          {%- endif -%}
        </div>
        {%- if has_subtext -%}
          <p class="jm-reviews-sub">{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="jm-reviews-widget">
      <!-- Start of Judge.me code -->
      {% assign has_legacy = false %}
      {% if jm_product.metafields.judgeme.widget.size > 20 %}
        {% assign has_legacy = true %}
      {% endif %}
      <div style='clear:both'></div>
      <div id='judgeme_product_reviews'
           class='jdgm-widget jdgm-review-widget'
           data-product-title='{{ jm_product.title | escape }}'
           data-id='{{ jm_product.id }}'
           data-product-id='{{ jm_product.id }}'
           data-widget='review'
           data-auto-install='false'
           data-shop-reviews-count='{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}'
           data-entry-point='review_widget.js'
           data-entry-key='review-widget/main.js'>
        {% if has_legacy %}
          <div class='jdgm-legacy-widget-content' style='display: none;'>
            {{ jm_product.metafields.judgeme.widget }}
          </div>
        {% endif %}
      </div>
      {% if jm_product.metafields.judgeme.review_widget_data %}
        <script>
          jdgm.data ||= {};
          jdgm.data.reviewWidget ||= {};
          jdgm.data.reviewWidget[{{ jm_product.id }}] = {{ jm_product.metafields.judgeme.review_widget_data }}
        </script>
      {% endif %}
      <!-- End of Judge.me code -->
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Judge.me Bewertungen",
  "settings": [
    { "type": "product", "id": "product", "label": "Produkt", "info": "Nur nötig, wenn die Section nicht auf einer Produktseite steht — etwa auf der Startseite." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "06 — Bewertungen" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Was Kunden sagen." },
    { "type": "text", "id": "subtext", "label": "Subtext", "info": "Steht rechts neben der Headline. Leer lassen, um ihn auszublenden.", "default": "Alle Bewertungen stammen von verifizierten Käufern und werden ungefiltert angezeigt." },
    { "type": "header", "content": "Darstellung" },
    { "type": "select", "id": "bg", "label": "Hintergrund", "options": [
        { "value": "paper", "label": "Standard" },
        { "value": "paper_2", "label": "Abgesetzt (grau)" }
      ], "default": "paper" },
    { "type": "checkbox", "id": "hide_widget_title", "label": "Überschrift des Judge.me-Widgets ausblenden", "default": true, "info": "Empfohlen, solange oben eine eigene Headline steht — sonst stehen zwei Überschriften untereinander." },
    { "type": "checkbox", "id": "hide_review_date", "label": "Datum der Bewertungen ausblenden", "default": true },
    { "type": "checkbox", "id": "hide_review_count", "label": "Gesamtzahl der Bewertungen ausblenden", "default": true },
    { "type": "checkbox", "id": "show_avg_stars", "label": "Sterne neben der Durchschnittsnote anzeigen", "default": true, "info": "Judge.me gibt dort nur die Zahl aus. Die Sterne zeichnet das Theme im Shop-Design dazu." },
    { "type": "checkbox", "id": "hide_media_gallery", "label": "Bilder-Galerie über der Liste ausblenden", "default": true, "info": "Judge.me zeigt dort alle Fotos noch einmal. Die Bilder in den einzelnen Bewertungen bleiben sichtbar." }
  ],
  "presets": [
    { "name": "Judge.me Bewertungen" }
  ]
}
{% endschema %}
